+    private fun uploadToSmb(song: Song, job: Job, media: SongStorage.Media) {
+        val config = checkNotNull(job.smb) { "请先设置 SMB 共享盘" }
+        val file = (media as? SongStorage.FileMedia)?.file ?: error("SMB 上传需要本地临时文件")
+        val client = SmbClient(config)
+        // 访客只读时这里必然失败：提前报错走退回本地流程，不等到复制一半。
+        // SmbClient.write 写失败时已删除 SMB 上的半截文件。
+        try {
+            check(client.testWrite()) { "SMB 共享盘不可写" }
+        } catch (error: Exception) {
+            throw IOException("SMB 共享盘不可写，请用有写权限的账号，或退回本地", error)
+        }
+        val extension = media.name.substringAfterLast('.', "mkv")
+        val clean = "${song.singer.orEmpty()}-${song.title.orEmpty()}"
+            .replace(Regex("[\\\\/:*?\"<>|]"), "_").take(180).ifBlank { "歌曲" }
+        val name = if (!song.sourceSongNumber.isNullOrBlank()) job.filename else "$clean.$extension"
+        val targetPath = config.child(name)
+        val total = file.length().coerceAtLeast(1L)
+        client.write(file, targetPath) { copied ->
+            progress(song, job, (50 + copied * 49 / total).toInt())
+        }
+        song.smbServer = config.normalizedServer()
+        song.smbPath = targetPath
+        song.path = null
+        song.downloadUrl = null; song.videoUrl = null
+        PersonalMediaStore.remember(song)
+        job.progress = 100
+        job.callbacks.forEach { it.onDownloadComplete(song, "") }
+    }
