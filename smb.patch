diff --git a/app/src/main/java/com/local/ktv/SongLibrary.kt b/app/src/main/java/com/local/ktv/SongLibrary.kt
index 28a1be5..733060b 100644
--- a/app/src/main/java/com/local/ktv/SongLibrary.kt
+++ b/app/src/main/java/com/local/ktv/SongLibrary.kt
@@ -14,6 +14,48 @@ class SongLibrary {
     private val cloudCatalog = OpenListCatalog()
     @Volatile var openListScanError: String? = null
 
+    // SMB 共享盘索引：只在内存中（SMB 没有本地目录文件可缓存），普通刷新
