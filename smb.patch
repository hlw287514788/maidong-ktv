diff --git a/app/src/main/java/com/local/ktv/SongLibrary.kt b/app/src/main/java/com/local/ktv/SongLibrary.kt
index 28a1be5..77bc3eb 100644
--- a/app/src/main/java/com/local/ktv/SongLibrary.kt
+++ b/app/src/main/java/com/local/ktv/SongLibrary.kt
@@ -1,6 +1,7 @@
 package com.local.ktv
 
 import org.json.JSONArray
+import org.json.JSONObject
 import java.io.File
 import java.util.Locale
 
@@ -14,6 +15,216 @@ class SongLibrary {
     private val cloudCatalog = OpenListCatalog()
     @Volatile var openListScanError: String? = null
 
+    // SMB 共享盘索引：v13 起落盘保存（smb-songs.json，见下面），普通刷新
+    // 恢复上次索引；扫描失败只记错误，不清空曲库、不覆盖落盘文件。
+    private val smbSongs = mutableListOf<Song>()
+    @Volatile var smbScanError: String? = null
+    // v13：最近一次 SMB 扫描扫到的歌数。成功时是本次歌数；失败时是
+    // 保留的旧索引歌数；从未扫描过时是 0。MainActivity 的 SMB 加歌
+    // 提示用它报真实首数，不再只凭“没报错”就弹“已加入”。
+    @Volatile var smbScanCount: Int = 0
+    // v14：最近一次 SMB 扫描列出的原始条数（过滤媒体文件之前）。
+    // 只在 syncSmb 真正列目录时更新；loadCachedSmb 不碰它，这样它
+    // 始终代表上次真实列目录的结果。诊断用，不进任何提示文案：
+    // 原始条数 >0 但媒体首数为 0 = 列出来了、被扩展名过滤掉了；
+    // 原始条数也是 0 = 列目录本身仍有问题。
+    @Volatile var smbScanRawCount: Int = 0
+    // v15：最近一次 SMB 扫描的列目录诊断（只读诊断，不改扫描结果）。
+    // count = -1 表示该次尝试失败，>= 0 表示列出的条数；未做过诊断
+    // 时全部为 -1。MainActivity 的 0 首提示用根目录/共享目录两项。
+    @Volatile var smbDiagRootCount: Int = -1
+    @Volatile var smbDiagConfigCount: Int = -1
+    @Volatile var smbDiagNamesCount: Int = -1
+    @Volatile var smbDiagCaseCount: Int = -1
+    @Volatile var smbDiagCasePath: String? = null
+    @Volatile var smbListingDiagnosis: SmbClient.ListingDiagnosis? = null
+    // 只记服务器/共享名/文件夹三元组（不含账号密码），供没有 config
+    // 参数的 removeSmb 在删除后重写落盘文件时用。
+    private var lastSmbIndexKey: Triple<String, String, String>? = null
+
+    // v13：SMB 索引文件，仿 OpenListCatalog 的 openlist-songs.json。
+    // 内容只有服务器/共享名/文件夹和歌曲 JSON；歌曲 JSON 本来就只含
+    // smbServer/smbPath 等身份字段，绝不含 SMB 账号密码。
+    private fun smbCacheFile(): File? = runCatching {
+        File(KtvApplication.getInstance().filesDir, "smb-songs.json")
+    }.getOrNull()
+
+    private fun saveSmbIndex(server: String, share: String, root: String) {
+        runCatching {
+            val file = smbCacheFile() ?: return
+            val rows = JSONArray().apply { smbSongsSnapshot().forEach { put(it.toJson()) } }
+            val temporary = File(file.parentFile, file.name + ".tmp")
+            temporary.writeText(JSONObject().put("server", server).put("share", share)
+                .put("root", root).put("songs", rows).toString())
+            if (!temporary.renameTo(file)) {
+                android.util.Log.w("SongLibrary", "SMB 索引保存失败")
+            }
+        }.onFailure { android.util.Log.w("SongLibrary", "SMB 索引保存失败", it) }
+    }
+
+    // 返回 null = 没有落盘文件或文件损坏（调用方保留现有内存索引）；
+    // 返回空列表 = 文件存在但服务器/共享名/文件夹不匹配（旧服务歌单不混入）。
+    private fun readSmbIndex(config: SmbConfig): List<Song>? = runCatching {
+        val file = smbCacheFile() ?: return null
+        if (!file.exists()) return null
+        val data = JSONObject(file.readText())
+        if (data.optString("server") != config.normalizedServer() ||
+            data.optString("share") != config.share.trim() ||
+            data.optString("root") != config.normalizedRoot()) return emptyList()
+        val rows = data.getJSONArray("songs")
+        (0 until rows.length()).map { Song.fromJson(rows.getJSONObject(it)) }
+            .filter { it.isSmb() }
+    }.getOrNull()
+
+    fun loadCachedSmb(config: SmbConfig) {
+        smbScanError = null
+        val cached = readSmbIndex(config) ?: run {
+            synchronized(this) { smbScanCount = smbSongs.size }
+            return
+        }
+        synchronized(this) {
+            smbSongs.clear()
+            smbSongs.addAll(cached)
+            smbScanCount = smbSongs.size
+        }
+        lastSmbIndexKey = Triple(config.normalizedServer(), config.share.trim(), config.normalizedRoot())
+    }
+
+    fun syncSmb(config: SmbConfig) {
+        loadCachedSmb(config)
+        if (!config.isConfigured()) return
+        lastSmbIndexKey = Triple(config.normalizedServer(), config.share.trim(), config.normalizedRoot())
+        runCatching {
+            val client = SmbClient(config)
+            val allEntries = client.listFilesRecursive(config.normalizedRoot())
+            smbScanRawCount = allEntries.size
+            val entries = allEntries
+                .filter { OpenListPaths.media(it.name.lowercase(Locale.ROOT)) }
+            android.util.Log.i(
+                "SongLibrary",
+                "SMB 扫描：列出 ${allEntries.size} 条，媒体文件 ${entries.size} 首",
+            )
+            val raw = entries.map { entry ->
+                Song.local(entry.path, entry.name).apply {
+                    // Song.local 会把共享内路径当成本地路径填进 path；
+                    // SMB 歌曲没有本地文件，path 必须清空，否则 hasLocalFile
+                    // 会去本地查一个不存在的文件。身份只用 smbServer/smbPath。
+                    path = ""
+                    id = SmbConfig.smbId(config.normalizedServer(), entry.path)
+                    smbServer = config.normalizedServer()
+                    smbPath = entry.path
+                    filename = entry.name
+                }
+            }
+            // 共享盘全新扫描标题：Song.local 对纯数字文件名只能解析出
+            // “数字标题 + 本地歌曲”，跟本地扫描不一样——本地扫描会走
+            // LocalSongResolver，用编号去曲库查真正的歌名歌手。这里也
+            // 按编号去曲库查（IgebaCatalog.songsByNumbers，不自己写 SQL）：
