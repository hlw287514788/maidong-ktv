diff --git a/app/src/main/java/com/local/ktv/SmbBrowser.kt b/app/src/main/java/com/local/ktv/SmbBrowser.kt
new file mode 100644
index 0000000..69f4fdc
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbBrowser.kt
@@ -0,0 +1,171 @@
+package com.local.ktv
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.os.Handler
+import android.os.Looper
+import android.text.InputType
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.RadioButton
+import android.widget.RadioGroup
+import android.widget.TextView
+import android.widget.Toast
+import java.util.concurrent.ExecutorService
+
+/**
+ * SMB 共享盘配置入口，仿 OpenListBrowser 的 AlertDialog + SharedPreferences 模式。
+ *
+ * 通用做法，不针对任何一台服务器写死：服务器、共享名、文件夹、登录方式、
+ * 账号、密码、端口全部由用户填写，走标准 SMB 协议。
+ * 访客登录一般只读：选 SMB 当下载位置时，主界面会先提示换有写权限的账号，
+ * 这里的“测试写权限”按钮也是同一规则的提前验证。
+ * 所有网络操作都在后台线程做，失败只弹提示，不闪退。
+ */
+class SmbBrowser(
+    private val activity: Activity,
+    private val executor: ExecutorService,
+    private val onChanged: () -> Unit = {},
+) {
+    private val main = Handler(Looper.getMainLooper())
+    private val dialogs = mutableListOf<AlertDialog>()
+
+    fun close() {
+        dialogs.toList().forEach { it.dismiss() }
+        dialogs.clear()
+        main.removeCallbacksAndMessages(null)
+    }
+
+    private fun present(dialog: AlertDialog) {
+        dialogs.removeAll { !it.isShowing }
+        dialogs.add(dialog)
+        dialog.show()
+        dialog.window?.decorView?.let(TvFocusStyler::installTree)
+        listOf(AlertDialog.BUTTON_POSITIVE, AlertDialog.BUTTON_NEGATIVE, AlertDialog.BUTTON_NEUTRAL)
+            .mapNotNull { dialog.getButton(it) }.forEach(TvFocusStyler::installAction)
+    }
+
+    fun config(): SmbConfig = SmbConfig.load(activity)
+
+    fun show() = configure()
+
+    private fun configure() {
+        val saved = config()
+        val layout = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(24, 12, 24, 12)
+        }
+        fun input(label: String, value: String, secret: Boolean = false, numeric: Boolean = false): EditText {
+            layout.addView(TextView(activity).apply { text = label })
+            return EditText(activity).apply {
+                setSingleLine(true)
+                inputType = when {
+                    secret -> InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                    numeric -> InputType.TYPE_CLASS_NUMBER
+                    else -> InputType.TYPE_CLASS_TEXT
+                }
+                setText(value)
+                layout.addView(this)
+            }
+        }
+        val server = input("服务器地址（如 192.168.1.1，不含 smb:// 和共享名）", saved.server)
+        val share = input("共享名（如 songs）", saved.share)
+        val root = input("文件夹（如 /KTV，留 / 表示共享根目录）", saved.root)
+        layout.addView(TextView(activity).apply { text = "登录方式" })
+        val loginGroup = RadioGroup(activity).apply { orientation = RadioGroup.VERTICAL }
+        val guestButton = RadioButton(activity).apply { text = "访客登录（一般只读，能播不能下载到共享盘）" }
+        val accountButton = RadioButton(activity).apply { text = "账号密码登录" }
+        loginGroup.addView(guestButton)
+        loginGroup.addView(accountButton)
+        layout.addView(loginGroup)
+        val username = input("账号（访客登录可留空）", saved.username)
+        val password = input("密码", saved.password, secret = true)
+        val port = input("端口（默认 445）", saved.port.toString(), numeric = true)
+        fun applyLoginMode(guest: Boolean) {
+            username.isEnabled = !guest
+            password.isEnabled = !guest
+        }
+        if (saved.guest) guestButton.isChecked = true else accountButton.isChecked = true
+        applyLoginMode(saved.guest)
+        loginGroup.setOnCheckedChangeListener { _, _ -> applyLoginMode(guestButton.isChecked) }
+        val writeTestButton = Button(activity).apply { text = "测试写权限" }
+        layout.addView(writeTestButton)
+        writeTestButton.setOnClickListener {
+            val candidate = buildCandidate(server, share, root, guestButton, username, password, port)
+                ?: return@setOnClickListener
+            writeTestButton.isEnabled = false
+            writeTestButton.text = "正在测试…"
+            executor.execute {
+                val result = runCatching { SmbClient(candidate).testWrite() }
+                main.post {
+                    if (activity.isFinishing || activity.isDestroyed) return@post
+                    writeTestButton.isEnabled = true
+                    writeTestButton.text = "测试写权限"
+                    result.onSuccess { writable ->
+                        toast(if (writable) "写权限测试通过，可以下载到共享盘"
+                            else "共享盘不可写，请用有写权限的账号")
+                    }.onFailure {
+                        toast("写权限测试失败：${it.message ?: "请检查连接和账号权限"}")
+                    }
+                }
+            }
+        }
+        val dialog = AlertDialog.Builder(activity).setTitle("SMB 共享盘设置")
+            .setView(android.widget.ScrollView(activity).apply { addView(layout) })
+            .setPositiveButton("连接并保存", null)
+            .setNeutralButton("清除连接", null).setNegativeButton("取消", null).create()
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setOnClickListener {
+                SmbConfig.clear(activity)
+                dialog.dismiss()
+                onChanged()
+            }
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val candidate = buildCandidate(server, share, root, guestButton, username, password, port)
+                    ?: return@setOnClickListener
+                val button = dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                button.isEnabled = false
+                button.text = "正在连接…"
+                executor.execute {
+                    val result = runCatching { SmbClient(candidate).testConnection() }
+                    main.post {
+                        if (!dialog.isShowing || activity.isFinishing || activity.isDestroyed) return@post
+                        button.isEnabled = true
+                        button.text = "连接并保存"
+                        result.onSuccess {
+                            runCatching { SmbConfig.save(activity, candidate) }.onSuccess {
+                                dialog.dismiss()
+                                onChanged()
+                            }.onFailure { toast(it.message ?: "SMB 设置无效") }
+                        }.onFailure {
+                            toast("连接失败，请检查服务器、共享名、文件夹、登录方式和账号密码")
+                        }
+                    }
+                }
+            }
+        }
+        present(dialog)
+        // 遥控器样式会关闭触摸焦点；输入框仍需支持点击编辑。
+        listOf(server, share, root, username, password, port).forEach { it.isFocusableInTouchMode = true }
+    }
+
+    private fun buildCandidate(
+        server: EditText, share: EditText, root: EditText,
+        guestButton: RadioButton, username: EditText, password: EditText, port: EditText,
+    ): SmbConfig? {
+        return runCatching {
+            SmbConfig(
+                server = SmbConfig.normalizeServer(server.text.toString()),
+                share = share.text.toString().trim(),
+                root = root.text.toString().trim().ifBlank { "/" },
+                guest = guestButton.isChecked,
+                username = username.text.toString().trim(),
+                password = password.text.toString(),
+                port = port.text.toString().trim().toIntOrNull() ?: 445,
+            ).also { it.validate() }
+        }.getOrElse { toast(it.message ?: "SMB 设置无效"); null }
+    }
+
+    private fun toast(text: String) = Toast.makeText(activity, text, Toast.LENGTH_LONG).show()
+}
