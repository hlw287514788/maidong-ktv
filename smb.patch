diff --git a/app/src/main/java/com/local/ktv/SmbBrowser.kt b/app/src/main/java/com/local/ktv/SmbBrowser.kt
new file mode 100644
index 0000000..69f4fdc
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbBrowser.kt
@@ -0,0 +1,171 @@
+package com.local.ktv
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.os.Handler
+import android.os.Looper
+import android.text.InputType
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.RadioButton
+import android.widget.RadioGroup
+import android.widget.TextView
+import android.widget.Toast
+import java.util.concurrent.ExecutorService
+
+/**
+ * SMB 共享盘配置入口，仿 OpenListBrowser 的 AlertDialog + SharedPreferences 模式。
+ *
+ * 通用做法，不针对任何一台服务器写死：服务器、共享名、文件夹、登录方式、
+ * 账号、密码、端口全部由用户填写，走标准 SMB 协议。
+ * 访客登录一般只读：选 SMB 当下载位置时，主界面会先提示换有写权限的账号，
+ * 这里的“测试写权限”按钮也是同一规则的提前验证。
+ * 所有网络操作都在后台线程做，失败只弹提示，不闪退。
+ */
+class SmbBrowser(
+    private val activity: Activity,
+    private val executor: ExecutorService,
+    private val onChanged: () -> Unit = {},
+) {
+    private val main = Handler(Looper.getMainLooper())
+    private val dialogs = mutableListOf<AlertDialog>()
+
+    fun close() {
+        dialogs.toList().forEach { it.dismiss() }
+        dialogs.clear()
+        main.removeCallbacksAndMessages(null)
+    }
+
+    private fun present(dialog: AlertDialog) {
+        dialogs.removeAll { !it.isShowing }
+        dialogs.add(dialog)
+        dialog.show()
+        dialog.window?.decorView?.let(TvFocusStyler::installTree)
+        listOf(AlertDialog.BUTTON_POSITIVE, AlertDialog.BUTTON_NEGATIVE, AlertDialog.BUTTON_NEUTRAL)
+            .mapNotNull { dialog.getButton(it) }.forEach(TvFocusStyler::installAction)
+    }
+
+    fun config(): SmbConfig = SmbConfig.load(activity)
+
+    fun show() = configure()
+
+    private fun configure() {
+        val saved = config()
+        val layout = LinearLayout(activity).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(24, 12, 24, 12)
+        }
+        fun input(label: String, value: String, secret: Boolean = false, numeric: Boolean = false): EditText {
+            layout.addView(TextView(activity).apply { text = label })
+            return EditText(activity).apply {
+                setSingleLine(true)
+                inputType = when {
+                    secret -> InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                    numeric -> InputType.TYPE_CLASS_NUMBER
+                    else -> InputType.TYPE_CLASS_TEXT
+                }
+                setText(value)
+                layout.addView(this)
+            }
+        }
+        val server = input("服务器地址（如 192.168.1.1，不含 smb:// 和共享名）", saved.server)
+        val share = input("共享名（如 songs）", saved.share)
+        val root = input("文件夹（如 /KTV，留 / 表示共享根目录）", saved.root)
+        layout.addView(TextView(activity).apply { text = "登录方式" })
+        val loginGroup = RadioGroup(activity).apply { orientation = RadioGroup.VERTICAL }
+        val guestButton = RadioButton(activity).apply { text = "访客登录（一般只读，能播不能下载到共享盘）" }
+        val accountButton = RadioButton(activity).apply { text = "账号密码登录" }
+        loginGroup.addView(guestButton)
+        loginGroup.addView(accountButton)
+        layout.addView(loginGroup)
+        val username = input("账号（访客登录可留空）", saved.username)
+        val password = input("密码", saved.password, secret = true)
+        val port = input("端口（默认 445）", saved.port.toString(), numeric = true)
+        fun applyLoginMode(guest: Boolean) {
+            username.isEnabled = !guest
+            password.isEnabled = !guest
+        }
+        if (saved.guest) guestButton.isChecked = true else accountButton.isChecked = true
+        applyLoginMode(saved.guest)
+        loginGroup.setOnCheckedChangeListener { _, _ -> applyLoginMode(guestButton.isChecked) }
+        val writeTestButton = Button(activity).apply { text = "测试写权限" }
+        layout.addView(writeTestButton)
+        writeTestButton.setOnClickListener {
+            val candidate = buildCandidate(server, share, root, guestButton, username, password, port)
+                ?: return@setOnClickListener
+            writeTestButton.isEnabled = false
+            writeTestButton.text = "正在测试…"
+            executor.execute {
+                val result = runCatching { SmbClient(candidate).testWrite() }
+                main.post {
+                    if (activity.isFinishing || activity.isDestroyed) return@post
+                    writeTestButton.isEnabled = true
+                    writeTestButton.text = "测试写权限"
+                    result.onSuccess { writable ->
+                        toast(if (writable) "写权限测试通过，可以下载到共享盘"
+                            else "共享盘不可写，请用有写权限的账号")
+                    }.onFailure {
+                        toast("写权限测试失败：${it.message ?: "请检查连接和账号权限"}")
+                    }
+                }
+            }
+        }
+        val dialog = AlertDialog.Builder(activity).setTitle("SMB 共享盘设置")
+            .setView(android.widget.ScrollView(activity).apply { addView(layout) })
+            .setPositiveButton("连接并保存", null)
+            .setNeutralButton("清除连接", null).setNegativeButton("取消", null).create()
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setOnClickListener {
+                SmbConfig.clear(activity)
+                dialog.dismiss()
+                onChanged()
+            }
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val candidate = buildCandidate(server, share, root, guestButton, username, password, port)
+                    ?: return@setOnClickListener
+                val button = dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                button.isEnabled = false
+                button.text = "正在连接…"
+                executor.execute {
+                    val result = runCatching { SmbClient(candidate).testConnection() }
+                    main.post {
+                        if (!dialog.isShowing || activity.isFinishing || activity.isDestroyed) return@post
+                        button.isEnabled = true
+                        button.text = "连接并保存"
+                        result.onSuccess {
+                            runCatching { SmbConfig.save(activity, candidate) }.onSuccess {
+                                dialog.dismiss()
+                                onChanged()
+                            }.onFailure { toast(it.message ?: "SMB 设置无效") }
+                        }.onFailure {
+                            toast("连接失败，请检查服务器、共享名、文件夹、登录方式和账号密码")
+                        }
+                    }
+                }
+            }
+        }
+        present(dialog)
+        // 遥控器样式会关闭触摸焦点；输入框仍需支持点击编辑。
+        listOf(server, share, root, username, password, port).forEach { it.isFocusableInTouchMode = true }
+    }
+
+    private fun buildCandidate(
+        server: EditText, share: EditText, root: EditText,
+        guestButton: RadioButton, username: EditText, password: EditText, port: EditText,
+    ): SmbConfig? {
+        return runCatching {
+            SmbConfig(
+                server = SmbConfig.normalizeServer(server.text.toString()),
+                share = share.text.toString().trim(),
+                root = root.text.toString().trim().ifBlank { "/" },
+                guest = guestButton.isChecked,
+                username = username.text.toString().trim(),
+                password = password.text.toString(),
+                port = port.text.toString().trim().toIntOrNull() ?: 445,
+            ).also { it.validate() }
+        }.getOrElse { toast(it.message ?: "SMB 设置无效"); null }
+    }
+
+    private fun toast(text: String) = Toast.makeText(activity, text, Toast.LENGTH_LONG).show()
+}
diff --git a/app/src/main/java/com/local/ktv/SmbClient.kt b/app/src/main/java/com/local/ktv/SmbClient.kt
new file mode 100644
index 0000000..713fdbf
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbClient.kt
@@ -0,0 +1,219 @@
+package com.local.ktv
+
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.net.URLEncoder
+import java.util.Properties
+import jcifs.CIFSContext
+import jcifs.config.PropertyConfiguration
+import jcifs.context.BaseContext
+import jcifs.smb.NtlmPasswordAuthenticator
+import jcifs.smb.SmbFile
+import jcifs.smb.SmbRandomAccessFile
+
+/**
+ * 通用 SMB 客户端封装（jcifs-ng，纯 Java，无原生库）。
+ *
+ * 只依赖 jcifs-ng 对外公开的 API，不依赖任何 Android 24+ 方法：
+ * 目录遍历用普通的 for 循环和 HashSet，不用高版本才有的 Map 默认方法；
+ * 这里根本不用 HTTP，文件长度直接取 SmbFile.length()，不存在
+ * HttpURLConnection 高版本长度方法的问题。
+ *
+ * 线程规则：本类不做全局缓存。每次 new SmbClient(config) 新建一个
+ * CIFSContext，调用方在后台线程使用，绝不在主线程调用；所有方法抛出的
+ * 异常由调用方转成提示（见 SmbClientTest / 后续的设置 UI 接线），本类不弹
+ * Toast、不崩溃。SmbFile / SmbRandomAccessFile 用完必须 close，见
+ * [SmbDataSource] 和 [SmbHttpProxy]。
+ *
+ * 协议版本：默认最低 SMB 2.02、最高 SMB 3.11。jcifs-ng 2.1.x 的 SMB3
+ * 支持是逐步完善的，OpenWrt 的 Samba4 通常会协商到 SMB 2.1/3.0，这一档
+ * 是否在目标服务器上真的协商成功，必须在真机上验证（见 smb-gradle-note.md
+ * 里的验证清单），不能只凭文档断言。
+ */
+class SmbClient(private val config: SmbConfig) {
+
+    data class Entry(
+        val name: String,
+        /** 以 "/" 开头的共享内绝对路径，例如 "/KTV/周杰伦/晴天.mkv"。 */
+        val path: String,
+        val isDirectory: Boolean,
+        val size: Long,
+        val lastModified: Long,
+    )
+
+    private val context: CIFSContext = buildContext()
+
+    private fun buildContext(): CIFSContext {
+        config.validate()
+        val props = Properties()
+        props.setProperty("jcifs.smb.client.minVersion", "SMB202")
+        props.setProperty("jcifs.smb.client.maxVersion", "SMB311")
+        // 明文密码一律禁止；访客和账号都走 NTLM 安全协商。
+        props.setProperty("jcifs.smb.client.disablePlainTextPasswords", "true")
+        // 简单共享没有 DFS；关掉 DFS 可避免无 DFS 的路由器/ NAS 上多余的查找。
+        props.setProperty("jcifs.smb.client.dfs.disabled", "true")
+        props.setProperty("jcifs.smb.client.responseTimeout", "15000")
+        props.setProperty("jcifs.smb.client.soTimeout", "15000")
+        val base = BaseContext(PropertyConfiguration(props))
+        // 访客 = 不附加凭据的匿名上下文；账号 = NTLM 凭据上下文。
+        // 域名留空：家用 NAS / 路由器通常没有域，空域名即本机账号。
+        return if (config.guest) {
+            base
+        } else {
+            base.withCredentials(
+                NtlmPasswordAuthenticator(null, config.username, config.password),
+            )
+        }
+    }
+
+    /** 把共享内路径拼成 smb:// URL，每段单独做百分号编码（空格 -> %20，不是 +）。 */
+    fun urlFor(path: String): String {
+        require(config.within(path)) { "路径超出 SMB 歌曲目录范围" }
+        val host = config.normalizedServer()
+        val hostPart = if (config.port == 445) host else "$host:${config.port}"
+        val encoded = path.split('/').filter { it.isNotEmpty() }.joinToString("/") { segment ->
+            URLEncoder.encode(segment, "UTF-8").replace("+", "%20")
+        }
+        return "smb://$hostPart/${config.share.trim()}/$encoded"
+    }
+
+    fun fileFor(path: String): SmbFile = SmbFile(urlFor(path), context)
+
+    /** 列出一个目录的直属条目（不递归）。调用方负责过滤媒体文件。 */
+    fun list(path: String): List<Entry> {
+        val dir = fileFor(path)
+        require(dir.isDirectory) { "不是目录：$path" }
+        val children = dir.listFiles() ?: return emptyList()
+        val result = ArrayList<Entry>(children.size)
+        for (child in children) {
+            val name = child.name.trimEnd('/')
+            val childPath = SmbConfig.normalizePath(path).trimEnd('/') + "/" + name
+            result.add(
+                Entry(
+                    name = name,
+                    path = childPath,
+                    isDirectory = child.isDirectory,
+                    size = if (child.isDirectory) 0L else child.length(),
+                    lastModified = child.lastModified(),
+                ),
+            )
+        }
+        return result
+    }
+
+    /**
+     * 递归列出 root 下的全部文件，供曲库扫描复用。
+     * maxDepth 防死循环/超深目录；visited 用路径集合防符号链接式回环。
+     * 任何一层出错都直接抛给调用方，由调用方决定是保留上次索引还是提示。
+     */
+    fun listFilesRecursive(root: String, maxDepth: Int = 8): List<Entry> {
+        val result = ArrayList<Entry>()
+        val visited = HashSet<String>()
+        fun walk(path: String, depth: Int) {
+            if (depth > maxDepth) return
+            if (!visited.add(SmbConfig.normalizePath(path))) return
+            for (entry in list(path)) {
+                if (entry.isDirectory) {
+                    walk(entry.path, depth + 1)
+                } else {
+                    result.add(entry)
+                }
+            }
+        }
+        walk(root, 0)
+        return result
+    }
+
+    fun openInput(path: String): InputStream = fileFor(path).inputStream
+
+    fun openRandomAccess(path: String): SmbRandomAccessFile {
+        val file = fileFor(path)
+        require(!file.isDirectory) { "不能以随机读取方式打开目录：$path" }
+        return SmbRandomAccessFile(file, "r")
+    }
+
+    fun fileSize(path: String): Long = fileFor(path).length()
+
+    fun exists(path: String): Boolean = runCatching { fileFor(path).exists() }.getOrDefault(false)
+
+    /**
+     * 把本地文件写到 SMB。写之前先确保父目录存在；写失败时删除目标上的
+     * 半截文件再抛异常，保证下载到 SMB 不留半截文件（调用方的下载流程
+     * 也会在此基础上再做一次完整性复核）。
+     */
+    fun write(localFile: File, targetPath: String, onProgress: ((Long) -> Unit)? = null) {
+        require(localFile.isFile) { "本地临时文件不存在" }
+        ensureParentDirs(targetPath)
+        val target = fileFor(targetPath)
+        try {
+            localFile.inputStream().buffered().use { input ->
+                target.outputStream.buffered().use { output ->
+                    copyWithProgress(input, output, onProgress)
+                }
+            }
+        } catch (failure: Exception) {
+            runCatching { target.delete() }
+            throw failure
+        }
+    }
+
+    private fun ensureParentDirs(targetPath: String) {
+        val parent = SmbConfig.normalizePath(targetPath).substringBeforeLast('/', "")
+        if (parent.isEmpty() || parent == "/") return
+        // 从根往下逐级建目录；已存在的目录跳过，mkdirs 语义由逐级 exists 保证。
+        val parts = parent.split('/').filter { it.isNotEmpty() }
+        var current = ""
+        for (part in parts) {
+            current += "/$part"
+            val dir = fileFor(current)
+            if (!dir.exists()) dir.mkdir()
+        }
+    }
+
+    private fun copyWithProgress(input: InputStream, output: OutputStream, onProgress: ((Long) -> Unit)?) {
+        val buffer = ByteArray(128 * 1024)
+        var copied = 0L
+        while (true) {
+            val n = input.read(buffer)
+            if (n < 0) break
+            output.write(buffer, 0, n)
+            copied += n
+            if (onProgress != null) onProgress(copied)
+        }
+        output.flush()
+    }
+
+    /** 连通性测试：能列出 root 即通过；失败原因原样抛给调用方转提示。 */
+    fun testConnection() {
+        config.validate()
+        val root = config.normalizedRoot()
+        val dir = fileFor(root)
+        require(dir.exists()) { "SMB 歌曲目录不存在，请检查服务器、共享名和文件夹" }
+        require(dir.isDirectory) { "SMB 歌曲目录不是文件夹" }
+        // 真正触发一次网络往返，而不是只拼 URL。
+        dir.listFiles()
+    }
+
+    /**
+     * 写权限测试：写一个随机名临时文件再删掉。返回 true 表示可写；
+     * 访客只读、账号无写权限、目录只读时这里会抛异常，调用方应提示
+     * 用户换账号或退回本地，而不是静默把歌下到一半。
+     */
+    fun testWrite(): Boolean {
+        val probeName = ".maidong-write-" + java.util.UUID.randomUUID().toString() + ".tmp"
+        val probePath = config.child(probeName)
+        val probe = fileFor(probePath)
+        try {
+            probe.outputStream.use { output -> output.write(1) }
+            return true
+        } finally {
+            runCatching { if (probe.exists()) probe.delete() }
+        }
+    }
+
+    fun delete(path: String) {
+        val file = fileFor(path)
+        if (file.exists()) file.delete()
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbConfig.kt b/app/src/main/java/com/local/ktv/SmbConfig.kt
new file mode 100644
index 0000000..df0858f
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbConfig.kt
@@ -0,0 +1,129 @@
+package com.local.ktv
+
+import android.content.Context
+import java.util.Locale
+
+/**
+ * 通用 SMB 配置。绝不针对某一台服务器写死：服务器、共享名、文件夹、登录方式
+ * 全部由用户在设置里填写，走标准 SMB 协议，Windows、NAS、路由器均可。
+ *
+ * 保存方式与现有 OpenList 配置同级：SharedPreferences 明文保存（OpenList 的
+ * 令牌和目录密码目前也是这样保存的）。这是一个已知局限，不在本文件里假装
+ * 已加密；如需加强，应单独引入加密存储并迁移已有配置，不要在本类里拼一个
+ * 自制的弱加密。
+ *
+ * 路径规则与 OpenListPaths 保持一致：
+ * - root 永远是绝对路径形式，例如 "/" 或 "/KTV"，不含 "."、".."、反斜杠和 NUL。
+ * - 扫描/播放/下载时用到的相对路径一律先过 [child] / [normalizePath] 校验，
+ *   防止共享外的路径被拼出来。
+ */
+data class SmbConfig(
+    val server: String = "",
+    /** 不含协议头、不含端口的主机名或 IP，例如 "192.168.1.1"。 */
+    val share: String = "",
+    /** 共享下的子目录，例如 "/KTV"；"/" 表示共享根目录。 */
+    val root: String = "/",
+    /** true = 访客登录（只读居多）；false = 账号密码登录。 */
+    val guest: Boolean = true,
+    val username: String = "",
+    val password: String = "",
+    /** 默认 445；只有用户显式改过才会在 URL 里出现。 */
+    val port: Int = 445,
+) {
+    fun isConfigured(): Boolean = normalizeServer(server).isNotBlank() && share.isNotBlank()
+
+    /** 访客登录不需要账号；账号登录必须有用户名（密码可空，取决于服务器）。 */
+    fun validate() {
+        val host = normalizeServer(server)
+        require(host.isNotBlank()) { "请填写 SMB 服务器地址" }
+        require(!host.contains('/') && !host.contains('\\') && !host.contains(' ') &&
+            !host.contains('\u0000')) { "服务器地址无效" }
+        require(share.isNotBlank() && !share.contains('/') && !share.contains('\\') &&
+            !share.contains('\u0000')) { "共享名无效" }
+        require(port in 1..65535) { "端口无效" }
+        normalizePath(root)
+        if (!guest) require(username.isNotBlank()) { "账号登录请填写用户名" }
+    }
+
+    /** 用户可能粘贴 "smb://192.168.1.1/共享名" 形式的地址，这里只做剥离，不猜测。 */
+    fun normalizedServer(): String = normalizeServer(server)
+
+    fun normalizedRoot(): String = normalizePath(root)
+
+    /** root 下的子路径，例如 child("周杰伦/晴天.mkv") -> "/KTV/周杰伦/晴天.mkv"。 */
+    fun child(relative: String): String {
+        val base = normalizePath(root).trimEnd('/')
+        val clean = normalizePath("/" + relative.trimStart('/'))
+        return if (base.isEmpty()) clean else base + clean
+    }
+
+    /** 判断一条共享内路径是否在 root 范围内，供播放/下载前复核。 */
+    fun within(path: String): Boolean {
+        val base = normalizePath(root)
+        val target = normalizePath(path)
+        return base == "/" || target == base || target.startsWith(base + "/")
+    }
+
+    companion object {
+        private const val PREFS = "smb"
+
+        /** SMB 歌曲的稳定 id：服务器主机名 + 共享内路径的 SHA-256，前缀与 OpenList 区分。 */
+        fun smbId(server: String, path: String): String {
+            val bytes = java.security.MessageDigest.getInstance("SHA-256")
+                .digest((server + "\n" + path).toByteArray(Charsets.UTF_8))
+            return "smb:" + bytes.joinToString("") { "%02x".format(it.toInt() and 255) }
+        }
+
+        fun normalizeServer(value: String): String {
+            var host = value.trim()
+            if (host.lowercase(Locale.ROOT).startsWith("smb://")) {
+                host = host.substring("smb://".length)
+            }
+            // "主机/共享名" 这种粘贴只取主机部分，共享名仍以 share 字段为准。
+            val slash = host.indexOf('/')
+            if (slash >= 0) host = host.substring(0, slash)
+            // "主机:端口" 形式的粘贴也只取主机，端口以 port 字段为准。
+            val colon = host.indexOf(':')
+            if (colon >= 0) host = host.substring(0, colon)
+            return host.trim()
+        }
+
+        fun normalizePath(value: String): String {
+            require(!value.contains('\\') && !value.contains('\u0000')) { "目录路径无效" }
+            val parts = value.trim().split('/').filter { it.isNotEmpty() }
+            require(parts.none { it == "." || it == ".." }) { "目录不能包含相对路径" }
+            return "/" + parts.joinToString("/")
+        }
+
+        fun load(context: Context): SmbConfig {
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            return SmbConfig(
+                server = prefs.getString("server", "").orEmpty(),
+                share = prefs.getString("share", "").orEmpty(),
+                root = prefs.getString("root", "/").orEmpty().ifBlank { "/" },
+                guest = prefs.getBoolean("guest", true),
+                username = prefs.getString("username", "").orEmpty(),
+                password = prefs.getString("password", "").orEmpty(),
+                port = prefs.getInt("port", 445),
+            )
+        }
+
+        fun save(context: Context, config: SmbConfig) {
+            config.validate()
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            prefs.edit()
+                .putString("server", normalizeServer(config.server))
+                .putString("share", config.share.trim())
+                .putString("root", normalizePath(config.root))
+                .putBoolean("guest", config.guest)
+                .putString("username", config.username.trim())
+                .putString("password", config.password)
+                .putInt("port", config.port)
+                .apply()
+        }
+
+        fun clear(context: Context) {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().clear().apply()
+        }
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbDataSource.kt b/app/src/main/java/com/local/ktv/SmbDataSource.kt
new file mode 100644
index 0000000..903eca5
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbDataSource.kt
@@ -0,0 +1,99 @@
+package com.local.ktv
+
+import java.io.IOException
+import jcifs.smb.SmbRandomAccessFile
+
+/**
+ * 可拖动的 SMB 字节源：open / seek / read / close。
+ *
+ * 重要说明——为什么这里不是 Media3 DataSource：
+ * 本仓库 2.1.4 的播放器已经不是 Media3，而是原生 FFmpeg 会话
+ * （player/NativeFfmpegSession：file 走本地路径，http/https 走 URL，
+ * content:// 走可拖动的文件描述符）。给它一个 Media3 DataSource
+ * 在本仓库里是死代码，接不上去。
+ *
+ * 所以本类按 Media3 DataSource 的同名契约实现一个独立的可拖动源
+ * （open 返回长度、read 返回 -1 表示 EOF、seek 可任意定位），再由
+ * [SmbHttpProxy] 把它桥接到 FFmpeg 能直接打开的本地 HTTP 地址上。
+ * 将来如果播放器换回 Media3，只需在它外面包一层 DataSource 适配器，
+ * 本类的 seek/read 逻辑不用重写。
+ *
+ * 线程规则：同一实例同一时间只被一个线程使用（HTTP 代理每次连接都
+ * 新建一个实例，见 SmbHttpProxy）。close 后再次 read/seek 抛异常，
+ * 不静默返回错误数据。
+ */
+class SmbDataSource(
+    private val client: SmbClient,
+    private val path: String,
+) {
+    private var randomAccess: SmbRandomAccessFile? = null
+    private var closed = false
+
+    @Volatile var length: Long = -1L
+        private set
+
+    @Volatile var position: Long = 0L
+        private set
+
+    /** 打开随机读取句柄并返回文件总长度；失败时不留半开的句柄。 */
+    @Throws(IOException::class)
+    fun open(): Long {
+        check(!closed) { "SMB 数据源已关闭" }
+        if (randomAccess != null) return length
+        val handle = client.openRandomAccess(path)
+        try {
+            length = handle.length()
+            position = 0L
+            randomAccess = handle
+            return length
+        } catch (failure: IOException) {
+            runCatching { handle.close() }
+            throw failure
+        }
+    }
+
+    /** 定位到绝对偏移；超出 [0, length] 时抛异常，不静默钳制到别处。 */
+    @Throws(IOException::class)
+    fun seek(target: Long) {
+        check(!closed) { "SMB 数据源已关闭" }
+        val handle = randomAccess ?: throw IOException("SMB 数据源未打开")
+        require(target in 0..length) { "拖动位置超出文件范围" }
+        handle.seek(target)
+        position = target
+    }
+
+    /**
+     * 从当前位置读最多 [size] 字节，写入 [buffer] 的 [offset] 处。
+     * 返回实际读到的字节数；到文件尾返回 -1（与 Media3 / InputStream
+     * 的 EOF 约定一致）。单次 read 可能少于请求量，调用方应循环读满。
+     */
+    @Throws(IOException::class)
+    fun read(buffer: ByteArray, offset: Int, size: Int): Int {
+        check(!closed) { "SMB 数据源已关闭" }
+        val handle = randomAccess ?: throw IOException("SMB 数据源未打开")
+        if (position >= length) return -1
+        val want = minOf(size.toLong(), length - position).toInt()
+        val n = handle.read(buffer, offset, want)
+        if (n > 0) position += n
+        return n
+    }
+
+    /** 读满 [size] 字节或到文件尾；返回实际读到的字节数。 */
+    @Throws(IOException::class)
+    fun readFully(buffer: ByteArray, offset: Int, size: Int): Int {
+        var at = 0
+        while (at < size) {
+            val n = read(buffer, offset + at, size - at)
+            if (n < 0) break
+            at += n
+        }
+        return at
+    }
+
+    fun close() {
+        if (closed) return
+        closed = true
+        runCatching { randomAccess?.close() }
+        randomAccess = null
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbHttpProxy.kt b/app/src/main/java/com/local/ktv/SmbHttpProxy.kt
new file mode 100644
index 0000000..7bc7b2b
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbHttpProxy.kt
@@ -0,0 +1,177 @@
+package com.local.ktv
+
+import java.io.BufferedOutputStream
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.Locale
+
+/**
+ * 本地 HTTP 代理：把 SMB 文件桥接成 FFmpeg 能直接打开的地址。
+ *
+ * 原理：2.1.4 的原生 FFmpeg 会话（NativeFfmpegSession.open）对
+ * http/https URL 直接用 avformat_open_input 打开，且 FFmpeg 的 HTTP
+ * 协议在拖动时会发 Range 请求。代理只监听 127.0.0.1（本机回环，局域网
+ * 其他设备连不进来），每次 HTTP 连接新建一个 [SmbDataSource]，按
+ * Range 的起始位置 seek，再把字节流回去；拖动 = 新连接 + 新 Range，
+ * 不需要把整首歌先下完。
+ *
+ * 安全边界：
+ * - 只绑 127.0.0.1，不绑 0.0.0.0；只响应固定路径 "/smb"，其他路径 404。
+ * - 不做目录浏览、不接受写请求（只处理 GET，HEAD 返回头信息）。
+ * - 播放结束或切歌时调用方必须调用 [stop]，否则回环端口会一直占着。
+ * - 任何一次连接里的 SMB 异常都只关掉这条连接，不杀掉整个代理，
+ *   也不让异常穿到主线程。
+ */
+class SmbHttpProxy(
+    private val client: SmbClient,
+    private val path: String,
+    private val fileName: String,
+) {
+    @Volatile private var server: ServerSocket? = null
+    @Volatile private var acceptThread: Thread? = null
+    @Volatile private var running = false
+
+    /** 启动后返回给播放器的地址，例如 http://127.0.0.1:54321/smb 。 */
+    @Volatile var url: String? = null
+        private set
+
+    @Synchronized
+    fun start(): String {
+        if (running) return checkNotNull(url) { "代理已启动但地址缺失" }
+        val socket = ServerSocket(0, 8, java.net.InetAddress.getByName("127.0.0.1"))
+        server = socket
+        running = true
+        url = "http://127.0.0.1:${socket.localPort}/smb"
+        val thread = Thread({ acceptLoop(socket) }, "SmbHttpProxy-accept")
+        thread.isDaemon = true
+        acceptThread = thread
+        thread.start()
+        return checkNotNull(url)
+    }
+
+    @Synchronized
+    fun stop() {
+        running = false
+        runCatching { server?.close() }
+        server = null
+        url = null
+    }
+
+    private fun acceptLoop(socket: ServerSocket) {
+        while (running) {
+            val connection = try {
+                socket.accept()
+            } catch (ignored: Exception) {
+                // stop() 关掉 ServerSocket 时 accept 会抛异常，这是正常退出路径。
+                break
+            }
+            val worker = Thread({ handle(connection) }, "SmbHttpProxy-worker")
+            worker.isDaemon = true
+            worker.start()
+        }
+    }
+
+    private fun handle(connection: Socket) {
+        var source: SmbDataSource? = null
+        try {
+            connection.soTimeout = 15000
+            val reader = BufferedReader(InputStreamReader(connection.getInputStream(), Charsets.US_ASCII))
+            val requestLine = reader.readLine() ?: return
+            val parts = requestLine.split(' ')
+            if (parts.size < 2 || parts[0] != "GET" && parts[0] != "HEAD") {
+                writeStatus(connection, 405, "Method Not Allowed", 0L, null)
+                return
+            }
+            if (parts[1] != "/smb") {
+                writeStatus(connection, 404, "Not Found", 0L, null)
+                return
+            }
+            var rangeStart: Long? = null
+            var rangeEnd: Long? = null
+            while (true) {
+                val header = reader.readLine() ?: break
+                if (header.isEmpty()) break
+                if (header.lowercase(Locale.ROOT).startsWith("range:")) {
+                    // 只支持单段 Range：bytes=start- 或 bytes=start-end。
+                    val value = header.substringAfter(':').trim()
+                    if (value.startsWith("bytes=")) {
+                        val range = value.substring("bytes=".length).split('-')
+                        if (range.size == 2) {
+                            rangeStart = range[0].toLongOrNull()
+                            rangeEnd = range[1].toLongOrNull()
+                        }
+                    }
+                }
+            }
+            source = SmbDataSource(client, path)
+            val total = source.open()
+            val start = (rangeStart ?: 0L).coerceIn(0L, total)
+            val end = (rangeEnd ?: (total - 1)).coerceIn(start, total - 1)
+            val bodyLength = if (total == 0L) 0L else end - start + 1
+            val isRange = rangeStart != null
+            val status = if (isRange) 206 else 200
+            val statusText = if (isRange) "Partial Content" else "OK"
+            val extra = if (isRange) "Content-Range: bytes $start-$end/$total\r\n" else ""
+            writeStatus(
+                connection, status, statusText, bodyLength,
+                extra + "Accept-Ranges: bytes\r\n" +
+                    "Content-Type: " + contentTypeFor(fileName) + "\r\n",
+            )
+            if (parts[0] == "HEAD" || total == 0L) return
+            source.seek(start)
+            val output = BufferedOutputStream(connection.getOutputStream())
+            val buffer = ByteArray(128 * 1024)
+            var remaining = bodyLength
+            while (remaining > 0) {
+                val want = minOf(buffer.size.toLong(), remaining).toInt()
+                val n = source.read(buffer, 0, want)
+                if (n < 0) break
+                output.write(buffer, 0, n)
+                remaining -= n
+            }
+            output.flush()
+        } catch (ignored: Exception) {
+            // 客户端断开、SMB 断线、拖动取消都会走到这里：只关本条连接。
+        } finally {
+            runCatching { source?.close() }
+            runCatching { connection.close() }
+        }
+    }
+
+    private fun writeStatus(
+        connection: Socket,
+        code: Int,
+        text: String,
+        bodyLength: Long,
+        extraHeaders: String?,
+    ) {
+        val head = StringBuilder()
+        head.append("HTTP/1.1 ").append(code).append(' ').append(text).append("\r\n")
+        head.append("Content-Length: ").append(bodyLength).append("\r\n")
+        if (!extraHeaders.isNullOrEmpty()) head.append(extraHeaders)
+        head.append("Connection: close\r\n")
+        head.append("\r\n")
+        val output = BufferedOutputStream(connection.getOutputStream())
+        output.write(head.toString().toByteArray(Charsets.US_ASCII))
+        output.flush()
+    }
+
+    private fun contentTypeFor(name: String): String {
+        return when (name.substringAfterLast('.', "").lowercase(Locale.ROOT)) {
+            "mkv" -> "video/x-matroska"
+            "mp4", "m4v" -> "video/mp4"
+            "avi" -> "video/x-msvideo"
+            "mpg", "mpeg" -> "video/mpeg"
+            "ts", "m2ts" -> "video/mp2t"
+            "mov" -> "video/quicktime"
+            "webm" -> "video/webm"
+            "mp3" -> "audio/mpeg"
+            "flac" -> "audio/flac"
+            "wav" -> "audio/wav"
+            "m4a" -> "audio/mp4"
+            else -> "application/octet-stream"
+        }
+    }
+}
