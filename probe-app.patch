diff --git a/app/src/main/java/com/local/ktv/ffmpeg/FfmpegProbe.kt b/app/src/main/java/com/local/ktv/ffmpeg/FfmpegProbe.kt
new file mode 100644
index 0000000..7ab73f5
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/ffmpeg/FfmpegProbe.kt
@@ -0,0 +1,25 @@
+package com.local.ktv.ffmpeg
+
+/**
+ * Phase-2 step 1: probe only, never plays/decodes/renders.
+ * Hardened vs the phase-1 skeleton: System.loadLibrary is NOT run in
+ * object init (that would crash the app on first access if the .so is
+ * missing); it runs inside probe()'s runCatching and any failure is
+ * returned as jni_failed JSON, never thrown to the caller.
+ * Callers must treat "ok":false as "probe unavailable", never as a
+ * playback failure. No password/token is ever passed to native code.
+ */
+object FfmpegProbe {
+    @Volatile private var libraryLoaded = false
+
+    /** Raw JSON from nativeProbe; never null, always contains "ok". */
+    external fun nativeProbe(path: String): String
+
+    fun probe(path: String): String = runCatching {
+        if (!libraryLoaded) {
+            System.loadLibrary("ffmpeg_probe")
+            libraryLoaded = true
+        }
+        nativeProbe(path)
+    }.getOrElse { "{\"ok\":false,\"error\":\"jni_failed\",\"detail\":\"${it.javaClass.simpleName}\"}" }
+}
