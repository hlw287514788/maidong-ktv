@@ -0,0 +1,33 @@
+# Phase-2 step 1: FFmpeg probe only (no playback, no rendering).
+# ndkBuild is used (not CMake) to match upstream 2.1.4's existing native
+# build system: app/build.gradle in the probe build enables ndkBuild with
+# this file, and third_party/ffmpeg is already present in the upstream
+# clone (arthenica ffmpeg-kit-full 6.0.LTS, see CI checklist) — no
+# binary is added by the text patch, and no .so is downloaded here.
+LOCAL_PATH := $(call my-dir)
+FFMPEG_ROOT := $(LOCAL_PATH)/../../../../third_party/ffmpeg
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := avutil
+LOCAL_SRC_FILES := $(FFMPEG_ROOT)/lib/$(TARGET_ARCH_ABI)/libavutil.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := avcodec
+LOCAL_SRC_FILES := $(FFMPEG_ROOT)/lib/$(TARGET_ARCH_ABI)/libavcodec.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := avformat
+LOCAL_SRC_FILES := $(FFMPEG_ROOT)/lib/$(TARGET_ARCH_ABI)/libavformat.so
+include $(PREBUILT_SHARED_LIBRARY)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := ffmpeg_probe
+LOCAL_SRC_FILES := ffmpeg_probe.cpp
+LOCAL_C_INCLUDES := $(FFMPEG_ROOT)/include
+LOCAL_CPPFLAGS := -std=c++17 -Wall -Wextra -Werror=return-type -fexceptions
+LOCAL_LDFLAGS := -Wl,-z,max-page-size=16384
+LOCAL_SHARED_LIBRARIES := avformat avcodec avutil
+LOCAL_LDLIBS := -landroid -llog
+include $(BUILD_SHARED_LIBRARY)
