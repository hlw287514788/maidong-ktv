+APP_PLATFORM := android-21
+APP_STL := c++_shared
+# Dual ABI on purpose: ship BOTH armeabi-v7a and arm64-v8a and let the
+# PackageManager pick the H2's primary ABI at install time. Do NOT pin
+# to one ABI — the H2's runtime ABI is settled by the probe itself
+# (Build.SUPPORTED_ABIS, logged with every probe run), not by guessing
+# from the MStar 838 Cortex-A53 (64-bit-capable) chip name.
+APP_ABI := armeabi-v7a arm64-v8a
diff --git a/app/src/main/cpp/ffmpeg_probe.cpp b/app/src/main/cpp/ffmpeg_probe.cpp
new file mode 100644
index 0000000..fb466b1
--- /dev/null
+++ b/app/src/main/cpp/ffmpeg_probe.cpp
@@ -0,0 +1,120 @@
+// Phase-1 probe only: open a file with FFmpeg avformat and list its streams.
+// This file deliberately does NOT decode, render, or play anything.
+// It answers exactly one question for phase 2:
+//   "Can the Android FFmpeg build recognise this IKTV container, and is
+//    h264_mediacodec present for the hardware-decode step?"
+//
+// Expected result for an IKTV .ts (desktop VLC, 2026-10-31):
+//   format contains mpegts (or an equivalent TS identifier),
+//   video stream: h264, 720x480,
+//   audio stream: mp2 / mpga,
+//   h264_mediacodec: present.
+// If the on-device probe does not match, phase 2 must stop (see PLAN.md §9).
+
+#include <jni.h>
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+extern "C" {
+#include <libavformat/avformat.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/avutil.h>
+}
+
+namespace {
+
+std::string jsonEscape(const std::string& in) {
+    std::string out;
+    for (char c : in) {
+        if (c == '"' || c == '\\') {
+            out += '\\';
+            out += c;
+        } else if (static_cast<unsigned char>(c) < 0x20) {
+            char buf[8];
+            std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+            out += buf;
+        } else {
+            out += c;
+        }
+    }
+    return out;
+}
+
+std::string probe(const char* path) {
+    AVFormatContext* format = nullptr;
+    int ret = avformat_open_input(&format, path, nullptr, nullptr);
+    if (ret < 0 || format == nullptr) {
+        char err[AV_ERROR_MAX_STRING_SIZE] = {0};
+        av_strerror(ret, err, sizeof(err));
+        return std::string("{\"ok\":false,\"error\":\"open_failed\",\"detail\":\"") +
+               jsonEscape(err) + "\"}";
+    }
+
+    ret = avformat_find_stream_info(format, nullptr);
+    if (ret < 0) {
+        char err[AV_ERROR_MAX_STRING_SIZE] = {0};
+        av_strerror(ret, err, sizeof(err));
+        avformat_close_input(&format);
+        return std::string("{\"ok\":false,\"error\":\"stream_info_failed\",\"detail\":\"") +
+               jsonEscape(err) + "\"}";
+    }
+
+    const bool mediacodecPresent =
+        avcodec_find_decoder_by_name("h264_mediacodec") != nullptr;
+
+    std::string out = "{\"ok\":true,\"format\":\"";
+    out += jsonEscape(format->iformat ? format->iformat->name : "");
+    out += "\",\"durationMs\":";
+    out += std::to_string(format->duration >= 0 ? format->duration / 1000 : -1);
+    out += ",\"h264_mediacodec\":";
+    out += mediacodecPresent ? "true" : "false";
+    out += ",\"streams\":[";
+
+    for (unsigned i = 0; i < format->nb_streams; ++i) {
+        const AVStream* stream = format->streams[i];
+        const AVCodecParameters* par = stream ? stream->codecpar : nullptr;
+        if (par == nullptr) continue;
+        if (i > 0) out += ",";
+        const char* type = "other";
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO) type = "video";
+        if (par->codec_type == AVMEDIA_TYPE_AUDIO) type = "audio";
+        const char* codecName = avcodec_get_name(par->codec_id);
+        out += "{\"index\":";
+        out += std::to_string(i);
+        out += ",\"type\":\"";
+        out += type;
+        out += "\",\"codec\":\"";
+        out += jsonEscape(codecName ? codecName : "");
+        out += "\",\"width\":";
+        out += std::to_string(par->width);
+        out += ",\"height\":";
+        out += std::to_string(par->height);
+        out += ",\"sampleRate\":";
+        out += std::to_string(par->sample_rate);
+        out += ",\"channels\":";
+        out += std::to_string(par->ch_layout.nb_channels);
+        out += "}";
+    }
+    out += "]}";
+    avformat_close_input(&format);
+    return out;
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegProbe_nativeProbe(JNIEnv* env, jclass /* clazz */,
+                                                  jstring path) {
+    if (path == nullptr) {
+        return env->NewStringUTF("{\"ok\":false,\"error\":\"null_path\"}");
+    }
+    const char* cpath = env->GetStringUTFChars(path, nullptr);
+    if (cpath == nullptr) {
+        return env->NewStringUTF("{\"ok\":false,\"error\":\"path_utf_failed\"}");
+    }
+    std::string result = probe(cpath);
+    env->ReleaseStringUTFChars(path, cpath);
+    return env->NewStringUTF(result.c_str());
+}
