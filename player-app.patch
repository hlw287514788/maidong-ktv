+extern "C" JNIEXPORT void JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeStop(JNIEnv* env, jobject thiz) {
+    Session* s = sessionFrom(env, thiz);
+    if (s == nullptr) return;
+    destroySession(s);
+    jclass cls = env->GetObjectClass(thiz);
+    jfieldID fid = env->GetFieldID(cls, "nativeHandle", "J");
+    if (fid != nullptr) env->SetLongField(thiz, fid, 0);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeSetPaused(
+    JNIEnv* env, jobject thiz, jboolean paused) {
+    Session* s = sessionFrom(env, thiz);
+    if (s == nullptr) return;
+    s->paused.store(paused);
+    if (!paused) s->wakeAll();
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeSelectAudioStream(
+    JNIEnv* env, jobject thiz, jint streamIndex) {
+    Session* s = sessionFrom(env, thiz);
+    if (s == nullptr) return;
+    bool present = false;
+    for (int idx : s->audioStreams) if (idx == streamIndex) present = true;
+    if (!present) return;
+    s->selectedAudioStream.store(streamIndex);
+    // Flush audio decoder and drop queued packets from the old
+    // stream; the reader will only queue the new stream from now on.
+    if (s->audioCtx) avcodec_flush_buffers(s->audioCtx);
+    s->audioQ.clear();
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeSetVocalMode(
+    JNIEnv* env, jobject thiz, jint mode, jfloat leftGain, jfloat rightGain) {
+    Session* s = sessionFrom(env, thiz);
+    if (s == nullptr) return;
+    s->vocalMode.store(mode);
+    s->leftGain.store(leftGain);
+    s->rightGain.store(rightGain);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeSeekTo(
+    JNIEnv* env, jobject thiz, jlong positionMs) {
+    Session* s = sessionFrom(env, thiz);
+    if (s == nullptr) return;
+    s->seekTargetMs.store((int64_t)positionMs);
+    s->wakeAll();
+}
+
+extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* vm, void* /* reserved */) {
+    g_vm = vm;
+    return JNI_VERSION_1_6;
+}
