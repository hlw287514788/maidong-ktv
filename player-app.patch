+// Phase-2 full playback (fallback only), step 1: first-frame-capable player.
+//
+// Pipeline, in one sentence:
+//   FFmpeg avformat demux -> video packets to Android NDK AMediaCodec
+//   ("video/avc", configured with the KtvVideoView Surface) -> hardware
+//   frames straight to that Surface; audio packets to FFmpeg mp2 decode
+//   -> PCM 16-bit -> Kotlin AudioTrack. No sws_scale, no RGBA, no
+//   ANativeWindow software rendering anywhere in this file.
+//
+// IMPORTANT DEVIATION FROM PLAN.md §2, FOUND BY CHECKING THE SHIPPED
+// HEADERS (do not "fix" this back silently):
+//   The ffmpeg-kit 6.0 headers shipped in upstream third_party/ffmpeg
+//   contain libavcodec/avcodec.h but NOT libavcodec/mediacodec.h, so
+//   av_mediacodec_alloc_context / av_mediacodec_default_init /
+//   av_mediacodec_release_buffer cannot be called against this build.
+//   The probe (2026-10-31, H2) proved h264_mediacodec EXISTS as a
+//   registered decoder name, which is a signal that the device's
+//   MediaCodec H.264 decoder exists -- the same OMX.MS.AVC decoder
+//   Media3 already uses on this device. This file therefore uses the
+//   other, header-independent mediacodec route: FFmpeg only demuxes,
+//   and the H.264 packets it extracts are fed to AMediaCodec, which
+//   is Android's own mediacodec hardware path and renders directly
+//   to the supplied Surface. If a future build ships full FFmpeg
+//   headers (or FFmpeg is built from source with --enable-mediacodec),
+//   only the video-decode thread below needs to change: replace the
+//   AMediaCodec block with avcodec_find_decoder_by_name(
+//   "h264_mediacodec") + av_mediacodec_* surface binding, keeping
+//   the reader, audio, clock, pause/stop and JNI contracts unchanged.
+//   Until that happens, do NOT claim this file calls FFmpeg's
+//   mediacodec decoder directly; claim exactly what it does:
+//   FFmpeg demux + Android mediacodec hardware decode.
+//
+// Scope (PLAN.md §1, task brief):
+//   Fallback only. Media3 stays the primary player for MKV/MP4. This
+//   session is created only after Media3 reports an extraction
+//   failure (3003 or equivalent, no first frame) for .ts/.m2ts/
+//   .mkv/.webm, and only once per song. If this session fails, the
+//   caller falls back to the existing retry/skip logic; this session
+//   never retries Media3 itself and never loops back into Media3.
+//
+// Audio / vocal model (probe, 2026-10-31, H2, local 1.TS):
+//   Two independent MP2 audio streams (index 1 and 2, 44100 Hz, 2 ch),
+//   NOT one stereo track split by channel. Vocal switching in this
+//   file is therefore STREAM selection first:
+//     original     -> first audio stream found
+//     accompaniment -> second audio stream found, if any
+//   If a file has only ONE audio stream, the fallback in the audio
+//   thread applies the KaraokeAudioProcessor channel logic (see
+//   applyKaraokeChannel below): LEFT = left sample copied to both
+//   ears, RIGHT = right sample copied to both ears, STEREO = as-is,
+//   each sample scaled by its ear gain and clamped to Short range.
+//   That logic is a REPLICATION of KtvVideoView's private
+//   KaraokeAudioProcessor (it cannot be reused: it is a Media3
+//   BaseAudioProcessor bound to Media3's audio pipeline), not a
+//   reuse of that class.
+//
+// Clock / sync:
+//   Audio is the master clock. The audio thread advances audioClockUs
+//   from the PCM samples it hands to Kotlin (sample count /
+//   sampleRate). The video thread renders a frame only when its PTS
+//   is <= audioClockUs + 40ms; frames more than 120ms late are
+//   dropped (released without rendering) so a slow start cannot
+//   accumulate lag. Before any audio has been written, video waits
+//   (bounded) for the audio clock instead of racing ahead.
+//   This is "good enough to play" sync, not frame-accurate sync;
+//   it is not claimed otherwise.
+//
+// Control contract (PLAN.md §4):
+//   The Kotlin session owns a generation snapshot (passed in from
+//   MainActivity.playbackGeneration at start). Every native callback
+//   carries no generation itself; the Kotlin layer checks the
+//   snapshot against MainActivity's current generation before acting
+//   (same pattern as setupPlayerListeners). Native stop() is
+//   idempotent, joins all threads, frees every context, and never
+//   calls back after stop() returns.
+//
+// Seek: best-effort only, NOT verified on H2 (see LIMITATIONS.md).
+//   seekTo() sets a seek command; the reader does avformat_seek_file
+//   to the target, flushes both decoders, clears both queues and
+//   resets the clocks. Precise frame-accurate seek, and seek-then-
+//   first-frame latency on MStar, are untested and must not be
+//   promised until the H2 checklist in PLAN.md §10 passes.
+//   Pitch / tone (Media3 PlaybackParameters) has NO equivalent here
+//   and is deliberately not implemented.
+
+#include <jni.h>
+#include <android/native_window_jni.h>
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+#include <media/NdkMediaError.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
