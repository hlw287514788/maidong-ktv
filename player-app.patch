+namespace {
+
+JavaVM* g_vm = nullptr;
+
+struct JniEnv {
+    JNIEnv* e = nullptr;
+    bool attached = false;
+    JniEnv() {
+        if (g_vm == nullptr) return;
+        if (g_vm->GetEnv(reinterpret_cast<void**>(&e), JNI_VERSION_1_6) != JNI_OK) {
+            attached = g_vm->AttachCurrentThread(&e, nullptr) == JNI_OK;
+        }
+    }
+    ~JniEnv() { if (attached && g_vm != nullptr) g_vm->DetachCurrentThread(); }
+};
+
+std::string avErrorText(int code) {
+    char buf[AV_ERROR_MAX_STRING_SIZE] = {0};
+    av_strerror(code, buf, sizeof(buf));
+    return buf;
+}
+
+// ---- Karaoke channel replication (see header comment) -----------------
+// mode: 0 = LEFT, 1 = RIGHT, 2 = STEREO (mirrors AudioChannels in
+// KtvVideoView.kt). Input/output are interleaved PCM 16-bit.
+// Returns the number of output samples written (always == inSamples
+// for stereo in, and 2x mono samples for mono in: mono is duplicated
+// to both ears, matching the old processor's "mono -> both ears"
+// behaviour only where the old code did that for a 1-channel input
+// by repeating per-channel samples; here mono is explicitly doubled).
+inline int16_t clampScaled(int16_t s, float gain) {
+    int v = static_cast<int>(static_cast<float>(s) * gain);
+    if (v > 32767) v = 32767;
+    if (v < -32768) v = -32768;
+    return static_cast<int16_t>(v);
+}
+
+// channels==2, mode LEFT/RIGHT/STEREO; channels==1, sample duplicated.
+size_t applyKaraokeChannel(const int16_t* in, size_t inSamples, int channels,
+                           int mode, float leftGain, float rightGain,
+                           int16_t* out) {
+    size_t o = 0;
+    if (channels == 2) {
+        for (size_t i = 0; i + 1 < inSamples; i += 2) {
+            int16_t l = in[i], r = in[i + 1];
+            int16_t selL, selR;
+            if (mode == 0) { selL = l; selR = l; }        // LEFT -> both ears
+            else if (mode == 1) { selL = r; selR = r; }   // RIGHT -> both ears
+            else { selL = l; selR = r; }                  // STEREO as-is
+            out[o++] = clampScaled(selL, leftGain);
+            out[o++] = clampScaled(selR, rightGain);
+        }
+    } else if (channels == 1) {
+        for (size_t i = 0; i < inSamples; ++i) {
+            out[o++] = clampScaled(in[i], leftGain);
+            out[o++] = clampScaled(in[i], rightGain);
+        }
+    } else {
+        // >2 channels: pass through first two channels only; this
+        // player does not claim surround support.
+        for (size_t i = 0; i + 1 < inSamples; i += channels) {
+            out[o++] = clampScaled(in[i], leftGain);
+            out[o++] = clampScaled(in[i + 1], rightGain);
+        }
+    }
+    return o;
+}
+
+struct QueuedPacket {
+    AVPacket* pkt = nullptr;
+    int streamIndex = -1;
+};
+
+struct PacketQueue {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<QueuedPacket> q;
+    void push(QueuedPacket p) {
+        { std::lock_guard<std::mutex> lk(mu); q.push_back(p); }
+        cv.notify_one();
+    }
+    // Returns false when stopped.
+    bool pop(QueuedPacket& out, const std::atomic<bool>& stop) {
+        std::unique_lock<std::mutex> lk(mu);
+        cv.wait(lk, [&] { return stop.load() || !q.empty(); });
+        if (q.empty()) return false;
+        out = q.front(); q.pop_front();
+        return true;
+    }
+    void clear() {
+        std::lock_guard<std::mutex> lk(mu);
+        for (auto& p : q) av_packet_free(&p.pkt);
+        q.clear();
+    }
+    void notifyAll() { cv.notify_all(); }
+};
+
+struct Session {
+    jobject owner = nullptr;  // global ref to FfmpegHwSession
+    jmethodID mPrepared = nullptr, mError = nullptr, mComplete = nullptr,
+              mPcm = nullptr, mProgress = nullptr, mFirstFrame = nullptr;
+
+    std::string path;
+    ANativeWindow* window = nullptr;
+
+    AVFormatContext* fmt = nullptr;
+    // videoCtx is intentionally UNUSED in this design: video decode
+    // is AMediaCodec, not AVCodec. It is kept only so destroySession
+    // / callPrepared signatures stay simple; width/height come from
+    // the stream parameters below, never from videoCtx.
+    AVCodecContext* videoCtx = nullptr;
+    int videoWidth = 0, videoHeight = 0;
+    AVCodecContext* audioCtx = nullptr;
+    AMediaCodec* videoCodec = nullptr;
+    AMediaFormat* videoFormat = nullptr;
+
+    int videoStream = -1, audioStreamCount = 0;
+    std::vector<int> audioStreams;  // stream indices, in file order
+    std::atomic<int> selectedAudioStream{-1};  // stream index, or -1
+    std::atomic<int> vocalMode{2};  // 0 LEFT, 1 RIGHT, 2 STEREO (single-stream fallback)
+    std::atomic<float> leftGain{1.0f}, rightGain{1.0f};
+
+    std::atomic<bool> stop{false}, paused{false}, failed{false};
+    std::atomic<int> drainedCount{0};
+    std::atomic<bool> firstFrameReported{false};
+    std::atomic<int64_t> audioClockUs{0};
+    std::atomic<int64_t> seekTargetMs{-1};
+    std::atomic<int> serial{1};
+    int64_t durationMs = -1;
+
+    PacketQueue videoQ, audioQ;
+    std::thread readerThread, videoThread, audioThread;
+    std::mutex pauseMu;
+    std::condition_variable pauseCv;
+
+    void waitIfPaused() {
+        std::unique_lock<std::mutex> lk(pauseMu);
+        pauseCv.wait(lk, [&] { return stop.load() || !paused.load(); });
+    }
+    void wakeAll() { videoQ.notifyAll(); audioQ.notifyAll(); pauseCv.notify_all(); }
+
+    void callError(int code, const std::string& msg) {
+        if (failed.exchange(true)) return;
+        JniEnv env;
+        if (env.e == nullptr) return;
+        jstring jmsg = env.e->NewStringUTF(msg.c_str());
+        env.e->CallVoidMethod(owner, mError, code, jmsg);
+        if (jmsg) env.e->DeleteLocalRef(jmsg);
+    }
+    void callComplete() {
+        JniEnv env;
+        if (env.e == nullptr) return;
+        env.e->CallVoidMethod(owner, mComplete);
+    }
+    // Called by a worker thread when it has drained its EOF marker.
+    // Completion is reported only after BOTH video and audio have
+    // drained, so the reader must NOT report completion at EOF (it
+    // would cut off the last queued packets).
+    void markDrainedAndMaybeComplete() {
+        if (stop.load() || failed.load()) return;
+        if (drainedCount.fetch_add(1) + 1 >= 2) callComplete();
+    }
+    void callFirstFrame() {
+        if (firstFrameReported.exchange(true)) return;
+        JniEnv env;
+        if (env.e == nullptr) return;
+        env.e->CallVoidMethod(owner, mFirstFrame);
+    }
+    void callPrepared() {
+        JniEnv env;
+        if (env.e == nullptr) return;
+        env.e->CallVoidMethod(owner, mPrepared, (jlong)durationMs,
+                              (jint)videoWidth,
+                              (jint)videoHeight,
+                              (jint)audioStreamCount);
+    }
+};
+
+// ---- video thread: AMediaCodec hardware decode to Surface ------------
+void videoLoop(Session* s) {
+    int64_t lastProgressMs = -1;
+    bool eofQueued = false;
+    while (!s->stop.load()) {
+        s->waitIfPaused();
+        if (s->stop.load()) break;
+        QueuedPacket qp;
+        if (!eofQueued) {
+            if (!s->videoQ.pop(qp, s->stop)) break;
+            if (qp.pkt == nullptr) {
+                // EOF marker: queue EOS to MediaCodec so already-queued
+                // frames are drained, then break only on EOS output below.
+                ssize_t eosIndex = AMediaCodec_dequeueInputBuffer(s->videoCodec, 2000);
+                if (eosIndex >= 0) {
+                    AMediaCodec_queueInputBuffer(s->videoCodec, (size_t)eosIndex, 0, 0, 0,
+                                                 AMEDIA_CODEC_BUFFER_FLAG_END_OF_STREAM);
+                }
+                eofQueued = true;
+                // Fall through to drain with no new packet.
+                qp.pkt = nullptr;
+                // Use a sentinel: skip feeding, go straight to drain.
+                // (Handled by the drain loop below reading no packet.)
+                // To keep the code simple, drain once here and continue.
+                for (;;) {
+                    AMediaCodecBufferInfo info;
+                    ssize_t outIndex = AMediaCodec_dequeueOutputBuffer(s->videoCodec, &info, 100000);
+                    if (outIndex < 0) break;
+                    bool isEos = (info.flags & AMEDIA_CODEC_BUFFER_FLAG_END_OF_STREAM) != 0;
+                    AMediaCodec_releaseOutputBuffer(s->videoCodec, (size_t)outIndex, !isEos);
+                    if (isEos) break;
+                    if (s->stop.load()) break;
+                }
+                break;
+            }
+        } else {
+            break;
+        }
+        // Feed packet to MediaCodec.
+        ssize_t inIndex = AMediaCodec_dequeueInputBuffer(s->videoCodec, 2000);
+        if (inIndex >= 0) {
+            size_t bufSize = 0;
+            uint8_t* buf = AMediaCodec_getInputBuffer(s->videoCodec, (size_t)inIndex, &bufSize);
+            if (buf != nullptr && bufSize >= (size_t)qp.pkt->size) {
+                std::memcpy(buf, qp.pkt->data, (size_t)qp.pkt->size);
+                int64_t ptsUs = qp.pkt->pts == AV_NOPTS_VALUE ? 0
+                    : av_rescale_q(qp.pkt->pts,
+                                   s->fmt->streams[s->videoStream]->time_base,
+                                   AVRational{1, 1000000});
+                AMediaCodec_queueInputBuffer(s->videoCodec, (size_t)inIndex, 0,
+                                             (size_t)qp.pkt->size, (uint64_t)ptsUs, 0);
+            } else {
+                AMediaCodec_queueInputBuffer(s->videoCodec, (size_t)inIndex, 0, 0, 0, 0);
+            }
+        }
+        av_packet_free(&qp.pkt);
+        // Drain outputs.
+        for (;;) {
+            AMediaCodecBufferInfo info;
+            ssize_t outIndex = AMediaCodec_dequeueOutputBuffer(s->videoCodec, &info, 0);
+            if (outIndex < 0) break;
+            if ((info.flags & AMEDIA_CODEC_BUFFER_FLAG_END_OF_STREAM) != 0) {
+                AMediaCodec_releaseOutputBuffer(s->videoCodec, (size_t)outIndex, false);
+                break;
+            }
+            int64_t ptsUs = (int64_t)info.presentationTimeUs;
+            int64_t clockUs = s->audioClockUs.load();
+            bool render = true;
+            if (clockUs > 0 && ptsUs > clockUs + 40000) {
+                // Too early: wait briefly, then re-check once. Do not
+                // spin: release without render only if still early
+                // after the wait, otherwise render on the next drain.
+                // Simplest bounded wait here keeps the loop from
+                // busy-looping on the audio clock.
+                std::this_thread::sleep_for(std::chrono::milliseconds(10));
+                clockUs = s->audioClockUs.load();
+                render = ptsUs <= clockUs + 40000;
+            } else if (clockUs > 0 && ptsUs + 120000 < clockUs) {
+                render = false;  // >120ms late: drop, do not accumulate lag
+            }
+            AMediaCodec_releaseOutputBuffer(s->videoCodec, (size_t)outIndex, render);
+            if (render) {
+                s->callFirstFrame();
+                int64_t posMs = ptsUs / 1000;
+                if (posMs != lastProgressMs && posMs - lastProgressMs >= 500) {
+                    lastProgressMs = posMs;
+                    JniEnv env;
+                    if (env.e != nullptr) {
+                        env.e->CallVoidMethod(s->owner, s->mProgress,
+                                              (jlong)posMs, (jlong)s->durationMs);
+                    }
+                }
+            }
+            if (s->stop.load()) break;
+        }
+    }
+    // EOF (or stop) reached: report drained so completion fires only
+    // after BOTH video and audio have drained (see markDrained).
+    if (!s->stop.load() && !s->failed.load()) s->markDrainedAndMaybeComplete();
+}
+
+// ---- audio thread: FFmpeg mp2 decode -> PCM -> Kotlin AudioTrack ----
+void audioLoop(Session* s) {
+    AVFrame* frame = av_frame_alloc();
+    if (frame == nullptr) { s->callError(-2, "av_frame_alloc failed"); return; }
+    while (!s->stop.load()) {
+        s->waitIfPaused();
+        if (s->stop.load()) break;
+        QueuedPacket qp;
+        if (!s->audioQ.pop(qp, s->stop)) break;
+        if (qp.pkt == nullptr) break;  // EOF marker
+        int ret = avcodec_send_packet(s->audioCtx, qp.pkt);
+        av_packet_free(&qp.pkt);
+        if (ret < 0 && ret != AVERROR(EAGAIN)) continue;
+        while (!s->stop.load()) {
+            ret = avcodec_receive_frame(s->audioCtx, frame);
+            if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) break;
+            if (ret < 0) break;
+            // FFmpeg mp2 decode gives s16 (or s16p). Handle both.
+            int channels = frame->ch_layout.nb_channels;
+            if (channels <= 0) channels = 2;
+            int samples = frame->nb_samples;
+            std::vector<int16_t> interleaved;
+            interleaved.reserve((size_t)samples * (size_t)channels);
+            if (frame->format == AV_SAMPLE_FMT_S16) {
+                const int16_t* p = reinterpret_cast<const int16_t*>(frame->data[0]);
+                interleaved.assign(p, p + (size_t)samples * (size_t)channels);
+            } else if (frame->format == AV_SAMPLE_FMT_S16P) {
+                for (int i = 0; i < samples; ++i)
+                    for (int c = 0; c < channels; ++c) {
+                        const int16_t* p = reinterpret_cast<const int16_t*>(frame->data[c]);
+                        interleaved.push_back(p[i]);
+                    }
+            } else {
+                // Unexpected sample format: do not guess, skip frame.
+                av_frame_unref(frame);
+                continue;
+            }
+            std::vector<int16_t> out;
+            out.resize(interleaved.size() * 2 + 16);
+            size_t outSamples = applyKaraokeChannel(
+                interleaved.data(), interleaved.size(), channels,
+                s->vocalMode.load(), s->leftGain.load(), s->rightGain.load(),
+                out.data());
+            // Advance the audio clock from the samples handed over.
+            int sampleRate = frame->sample_rate > 0 ? frame->sample_rate : 44100;
+            int64_t frameUs = (int64_t)samples * 1000000LL / sampleRate;
+            // The Kotlin side writes synchronously to AudioTrack; the
+            // clock advance here is an approximation of "written"
+            // time and is used only for video pacing, not for
+            // reporting exact position (progress comes from video PTS).
+            s->audioClockUs.fetch_add(frameUs);
+            JniEnv env;
+            if (env.e == nullptr) { av_frame_unref(frame); continue; }
+            jobject buf = env.e->NewDirectByteBuffer(out.data(), (jlong)(outSamples * 2));
+            if (buf != nullptr) {
+                env.e->CallBooleanMethod(s->owner, s->mPcm, buf,
+                                         (jint)sampleRate, (jint)2,
+                                         (jlong)(s->audioClockUs.load()));
+                env.e->DeleteLocalRef(buf);
+            }
+            av_frame_unref(frame);
+            if (s->stop.load()) break;
+        }
+    }
+    av_frame_free(&frame);
+    if (!s->stop.load() && !s->failed.load()) s->markDrainedAndMaybeComplete();
+}
+
+// ---- reader thread ----------------------------------------------------
+void readerLoop(Session* s) {
+    AVPacket* pkt = av_packet_alloc();
+    if (pkt == nullptr) { s->callError(-3, "av_packet_alloc failed"); return; }
+    bool videoEof = false, audioEof = false;
+    while (!s->stop.load()) {
+        s->waitIfPaused();
+        if (s->stop.load()) break;
+        int64_t seekMs = s->seekTargetMs.exchange(-1);
+        if (seekMs >= 0 && s->fmt != nullptr) {
+            int64_t ts = av_rescale_q(seekMs * 1000, AVRational{1, 1000000},
+                                      s->fmt->streams[s->videoStream]->time_base);
+            if (avformat_seek_file(s->fmt, s->videoStream, INT64_MIN, ts, INT64_MAX, 0) >= 0) {
+                // Video is AMediaCodec, not an AVCodecContext (videoCtx
+                // is intentionally unused in this design), so flush
+                // the MediaCodec instead of avcodec_flush_buffers.
+                if (s->videoCodec) AMediaCodec_flush(s->videoCodec);
+                if (s->audioCtx) avcodec_flush_buffers(s->audioCtx);
+                s->videoQ.clear(); s->audioQ.clear();
+                s->audioClockUs.store(seekMs * 1000);
+                videoEof = audioEof = false;
+            }
+            // If seek fails, keep playing from the current position;
+            // do not fail the whole song for a best-effort seek.
+        }
+        int ret = av_read_frame(s->fmt, pkt);
+        if (ret < 0) {
+            // EOF: push markers, then complete when both threads drain.
+            s->videoQ.push(QueuedPacket{nullptr, s->videoStream});
+            s->audioQ.push(QueuedPacket{nullptr, s->selectedAudioStream.load()});
+            break;
+        }
+        if (pkt->stream_index == s->videoStream && !videoEof) {
+            AVPacket* copy = av_packet_alloc();
+            if (copy && av_packet_ref(copy, pkt) >= 0) {
+                s->videoQ.push(QueuedPacket{copy, pkt->stream_index});
+            } else if (copy) av_packet_free(&copy);
+        } else if (pkt->stream_index == s->selectedAudioStream.load() && !audioEof) {
+            AVPacket* copy = av_packet_alloc();
+            if (copy && av_packet_ref(copy, pkt) >= 0) {
+                s->audioQ.push(QueuedPacket{copy, pkt->stream_index});
+            } else if (copy) av_packet_free(&copy);
+        }
+        // Packets from non-selected audio streams are dropped here:
+        // that IS the vocal-stream switch (no second decode, no mixing).
+        av_packet_unref(pkt);
+    }
+    av_packet_free(&pkt);
+    // Do NOT callComplete() here: completion fires only after BOTH
+    // worker threads drain their EOF markers (markDrainedAndMaybeComplete).
+    // Calling it here would advance to the next song before the last
+    // queued video/audio packets have played.
+    (void)videoEof; (void)audioEof;
+}
+
+Session* sessionFrom(JNIEnv* env, jobject thiz) {
+    jclass cls = env->GetObjectClass(thiz);
+    jfieldID fid = env->GetFieldID(cls, "nativeHandle", "J");
+    if (fid == nullptr) return nullptr;
+    return reinterpret_cast<Session*>(env->GetLongField(thiz, fid));
+}
+
+void destroySession(Session* s) {
+    if (s == nullptr) return;
+    s->stop.store(true);
+    s->wakeAll();
+    if (s->readerThread.joinable()) s->readerThread.join();
+    if (s->videoThread.joinable()) s->videoThread.join();
+    if (s->audioThread.joinable()) s->audioThread.join();
+    s->videoQ.clear(); s->audioQ.clear();
+    if (s->videoCodec) AMediaCodec_delete(s->videoCodec);
+    if (s->videoFormat) AMediaFormat_delete(s->videoFormat);
+    if (s->videoCtx) avcodec_free_context(&s->videoCtx);
+    if (s->audioCtx) avcodec_free_context(&s->audioCtx);
+    if (s->fmt) avformat_close_input(&s->fmt);
+    if (s->window) ANativeWindow_release(s->window);
+    JniEnv env;
+    if (env.e != nullptr) env.e->DeleteGlobalRef(s->owner);
+    delete s;
+}
