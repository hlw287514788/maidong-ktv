+extern "C" JNIEXPORT jlong JNICALL
+Java_com_local_ktv_ffmpeg_FfmpegHwSession_nativeStart(
+    JNIEnv* env, jobject thiz, jstring path, jobject surface,
+    jint vocalStreamIndex, jint vocalMode, jfloat leftGain, jfloat rightGain) {
+    if (path == nullptr || surface == nullptr) return 0;
+    const char* cpath = env->GetStringUTFChars(path, nullptr);
+    if (cpath == nullptr) return 0;
+    std::string spath(cpath);
+    env->ReleaseStringUTFChars(path, cpath);
+
+    Session* s = new Session();
+    s->path = spath;
+    s->owner = env->NewGlobalRef(thiz);
+    jclass cls = env->GetObjectClass(thiz);
+    s->mPrepared = env->GetMethodID(cls, "onNativePrepared", "(JIII)V");
+    s->mError = env->GetMethodID(cls, "onNativeError", "(ILjava/lang/String;)V");
+    s->mComplete = env->GetMethodID(cls, "onNativeComplete", "()V");
+    s->mPcm = env->GetMethodID(cls, "onNativePcm",
+                              "(Ljava/nio/ByteBuffer;IJI)Z");
+    s->mProgress = env->GetMethodID(cls, "onNativeProgress", "(JJ)V");
+    s->mFirstFrame = env->GetMethodID(cls, "onNativeFirstFrame", "()V");
+    s->vocalMode.store(vocalMode);
+    s->leftGain.store(leftGain);
+    s->rightGain.store(rightGain);
+
+    AVFormatContext* fmt = nullptr;
+    int ret = avformat_open_input(&fmt, spath.c_str(), nullptr, nullptr);
+    if (ret < 0 || fmt == nullptr) {
+        std::string msg = "avformat_open_input failed: " + avErrorText(ret);
+        // Report through a temporary error path: the Kotlin side will
+        // see nativeStart return 0 and treat it as start failure.
+        delete s;
+        (void)msg;
+        return 0;
+    }
+    s->fmt = fmt;
+    ret = avformat_find_stream_info(fmt, nullptr);
+    if (ret < 0) { destroySession(s); return 0; }
+    s->durationMs = fmt->duration >= 0 ? fmt->duration / 1000 : -1;
+
+    // Video: first video stream, must be H.264 for this fallback.
+    // Other video codecs are NOT claimed here; the caller checks the
+    // probe / stream info before starting and must not start this
+    // session for non-H.264 video (see LIMITATIONS.md).
+    for (unsigned i = 0; i < fmt->nb_streams; ++i) {
+        AVCodecParameters* par = fmt->streams[i]->codecpar;
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO && s->videoStream < 0 &&
+            par->codec_id == AV_CODEC_ID_H264) {
+            s->videoStream = (int)i;
+        }
+        if (par->codec_type == AVMEDIA_TYPE_AUDIO) {
+            s->audioStreams.push_back((int)i);
+        }
+    }
+    if (s->videoStream < 0) { destroySession(s); return 0; }
+    if (s->audioStreams.empty()) { destroySession(s); return 0; }
+    s->audioStreamCount = (int)s->audioStreams.size();
+    // Vocal stream selection: explicit index wins if present,
+    // otherwise first audio stream (original).
+    int selected = s->audioStreams[0];
+    for (int idx : s->audioStreams) if (idx == vocalStreamIndex) selected = idx;
+    s->selectedAudioStream.store(selected);
+
+    // Audio decoder: FFmpeg mp2 (or whatever the stream's codec is;
+    // the IKTV case is mp2, verified by probe). No mediacodec for audio.
+    AVStream* astream = fmt->streams[selected];
+    const AVCodec* acodec = avcodec_find_decoder(astream->codecpar->codec_id);
+    if (acodec == nullptr) { destroySession(s); return 0; }
+    s->audioCtx = avcodec_alloc_context3(acodec);
+    if (s->audioCtx == nullptr ||
+        avcodec_parameters_to_context(s->audioCtx, astream->codecpar) < 0 ||
+        avcodec_open2(s->audioCtx, acodec, nullptr) < 0) {
+        destroySession(s); return 0;
+    }
+
+    // Video hardware decode: AMediaCodec "video/avc" + Surface.
+    // This is the mediacodec hardware path (same decoder family
+    // Media3 uses on H2), fed with packets demuxed by FFmpeg.
+    s->window = ANativeWindow_fromSurface(env, surface);
+    if (s->window == nullptr) { destroySession(s); return 0; }
+    s->videoCodec = AMediaCodec_createDecoderByType("video/avc");
+    if (s->videoCodec == nullptr) { destroySession(s); return 0; }
+    s->videoFormat = AMediaFormat_new();
+    AMediaFormat_setString(s->videoFormat, AMEDIAFORMAT_KEY_MIME, "video/avc");
+    AVCodecParameters* vpar = fmt->streams[s->videoStream]->codecpar;
+    s->videoWidth = vpar->width;
+    s->videoHeight = vpar->height;
+    AMediaFormat_setInt32(s->videoFormat, AMEDIAFORMAT_KEY_WIDTH, vpar->width);
+    AMediaFormat_setInt32(s->videoFormat, AMEDIAFORMAT_KEY_HEIGHT, vpar->height);
+    // Extradata (SPS/PPS) is required for avc1-style streams; for
+    // Annex-B TS streams it is usually absent and the decoder
+    // recovers it from the first packets. Pass it through when present.
+    if (vpar->extradata != nullptr && vpar->extradata_size > 0) {
+        AMediaFormat_setBuffer(s->videoFormat, "csd-0",
+                               vpar->extradata, (size_t)vpar->extradata_size);
+    }
+    media_status_t st = AMediaCodec_configure(s->videoCodec, s->videoFormat,
+                                              s->window, nullptr, 0);
+    if (st != AMEDIA_OK) { destroySession(s); return 0; }
+    if (AMediaCodec_start(s->videoCodec) != AMEDIA_OK) { destroySession(s); return 0; }
+
+    // Threads start only after every context above succeeded.
+    s->readerThread = std::thread(readerLoop, s);
+    s->videoThread = std::thread(videoLoop, s);
+    s->audioThread = std::thread(audioLoop, s);
+    s->callPrepared();
+    return reinterpret_cast<jlong>(s);
+}
