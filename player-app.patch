+package com.local.ktv.ffmpeg
+
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.view.Surface
+import java.nio.ByteBuffer
+
+/**
+ * Phase-2 fallback player session (Kotlin side).
+ *
+ * Native side: ffmpeg_hw_player.cpp.
+ *   FFmpeg avformat demux -> video packets to AMediaCodec
+ *   ("video/avc" + Surface, hardware) -> audio packets to FFmpeg
+ *   mp2 decode -> PCM 16-bit -> onNativePcm() below -> AudioTrack.
+ *
+ * This class owns NO playback policy. It only:
+ *  - loads libffmpeg_hw_player (missing .so = start failure, never a crash),
+ *  - owns one AudioTrack, created lazily from the first PCM callback's
+ *    sample rate (channels are always stereo out: mono input is already
+ *    duplicated to both ears by the native Karaoke replication, and
+ *    stereo input stays stereo),
+ *  - forwards native callbacks to the lambdas MainActivity installs,
+ *    WITHOUT checking playbackGeneration itself -- the installing code
+ *    MUST check its generation snapshot before acting, exactly as
+ *    setupPlayerListeners does for Media3. A callback that arrives
+ *    after stop() is dropped here (nativeHandle == 0L) and must also
+ *    be dropped by the caller on generation mismatch.
+ *
+ * Vocal model (probe 2026-10-31, H2, local 1.TS):
+ *  - Two independent MP2 audio streams (index 1, 2). Original =
+ *    first audio stream, accompaniment = second, if present.
+ *  - selectVocalStream(streamIndex) switches the native reader to
+ *    that stream (old audio queue flushed). This is NOT a left/right
+ *    channel copy.
+ *  - setVocalChannelMode() is only for single-audio-stream files:
+ *    LEFT/RIGHT/STEREO channel replication in native code (see
+ *    applyKaraokeChannel in ffmpeg_hw_player.cpp).
+ *
+ * Threading: native reader/video/audio threads call back on their own
+ * threads. onNativePcm is called on the native audio thread and writes
+ * synchronously to AudioTrack; that write IS the audio pacing, so it
+ * must not be re-dispatched to the main thread. Progress/completion/
+ * error callbacks are cheap and may be re-dispatched by the caller.
+ */
+class FfmpegHwSession(
+    private val onPrepared: (durationMs: Long, width: Int, height: Int, audioStreamCount: Int) -> Unit,
+    private val onError: (code: Int, message: String) -> Unit,
+    private val onComplete: () -> Unit,
+    private val onProgress: (positionMs: Long, durationMs: Long) -> Unit,
+    private val onFirstFrame: () -> Unit,
+) {
+    // Must match the field name the native code reads via GetFieldID.
+    @Volatile
+    private var nativeHandle: Long = 0L
+
+    @Volatile
+    private var audioTrack: AudioTrack? = null
+    @Volatile
+    private var audioSampleRate: Int = 44100
+
+    @Volatile
+    var isStarted: Boolean = false
+        private set
+
+    companion object {
+        // Vocal stream indices are FILE stream indices (probe output),
+        // not "0/1" track ordinals. Callers must pass the actual index
+        // from the probe / stream list, e.g. 1 for original, 2 for
+        // accompaniment on IKTV 1.TS.
+        const val VOCAL_MODE_LEFT = 0
+        const val VOCAL_MODE_RIGHT = 1
+        const val VOCAL_MODE_STEREO = 2
+
+        private var libraryLoaded: Boolean? = null
+
+        @Synchronized
+        fun loadLibrary(): Boolean {
+            if (libraryLoaded != null) return libraryLoaded!!
+            libraryLoaded = runCatching { System.loadLibrary("ffmpeg_hw_player") }.isSuccess
+            return libraryLoaded!!
+        }
+    }
+
+    /**
+     * Start playback. Returns false (never throws) when the library
+     * is missing, the surface is invalid, the file cannot be opened,
+     * there is no H.264 video stream, or there is no audio stream.
+     * In all those cases the caller must fall back to existing
+     * retry/skip logic; this session must not be retried by itself.
+     */
+    fun start(
+        path: String,
+        surface: Surface,
+        vocalStreamIndex: Int,
+        vocalMode: Int = VOCAL_MODE_STEREO,
+        leftGain: Float = 1f,
+        rightGain: Float = 1f,
+    ): Boolean {
+        if (!loadLibrary()) return false
+        if (!surface.isValid) return false
+        if (nativeHandle != 0L) return false
+        val handle = runCatching {
+            nativeStart(path, surface, vocalStreamIndex, vocalMode, leftGain, rightGain)
+        }.getOrDefault(0L)
+        if (handle == 0L) return false
+        nativeHandle = handle
+        isStarted = true
+        return true
+    }
+
+    fun stop() {
+        if (nativeHandle == 0L) {
+            releaseAudioTrack()
+            return
+        }
+        runCatching { nativeStop() }
+        nativeHandle = 0L
+        isStarted = false
+        releaseAudioTrack()
+    }
+
+    fun setPaused(paused: Boolean) {
+        if (nativeHandle == 0L) return
+        runCatching { nativeSetPaused(paused) }
+        if (paused) runCatching { audioTrack?.pause() }
+        else runCatching { audioTrack?.play() }
+    }
+
+    /** Switch vocal stream (IKTV case). No-op if the index is absent. */
+    fun selectVocalStream(streamIndex: Int) {
+        if (nativeHandle == 0L) return
+        runCatching { nativeSelectAudioStream(streamIndex) }
+    }
+
+    /** Single-stream channel mode only; see class doc. */
+    fun setVocalChannelMode(mode: Int, leftGain: Float, rightGain: Float) {
+        if (nativeHandle == 0L) return
+        runCatching { nativeSetVocalMode(mode, leftGain, rightGain) }
+    }
+
+    /** Best-effort seek; precise seek is NOT verified on H2. */
+    fun seekTo(positionMs: Long) {
+        if (nativeHandle == 0L) return
+        runCatching { nativeSeekTo(positionMs) }
+    }
+
+    private fun releaseAudioTrack() {
+        runCatching { audioTrack?.stop() }
+        runCatching { audioTrack?.release() }
+        audioTrack = null
+    }
+
+    private fun ensureAudioTrack(sampleRate: Int) {
+        if (audioTrack != null && audioSampleRate == sampleRate) return
+        releaseAudioTrack()
+        audioSampleRate = sampleRate
+        val minBuf = AudioTrack.getMinBufferSize(
+            sampleRate, AudioFormat.CHANNEL_OUT_STEREO,
+            AudioFormat.ENCODING_PCM_16BIT,
+        ).coerceAtLeast(8192)
+        audioTrack = AudioTrack.Builder()
+            .setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_MEDIA)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                    .build(),
+            )
+            .setAudioFormat(
+                AudioFormat.Builder()
+                    .setSampleRate(sampleRate)
+                    .setChannelMask(AudioFormat.CHANNEL_OUT_STEREO)
+                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                    .build(),
+            )
+            .setBufferSizeInBytes(minBuf * 4)
+            .setTransferMode(AudioTrack.MODE_STREAM)
+            .build()
+        runCatching { audioTrack?.play() }
+    }
+
+    // ---- Called from native code. Names/signatures must match the
+    // ---- GetMethodID lookups in ffmpeg_hw_player.cpp exactly. ----
+
+    @Suppress("unused")
+    private fun onNativePrepared(durationMs: Long, width: Int, height: Int, audioStreamCount: Int) {
+        if (nativeHandle == 0L) return
+        onPrepared(durationMs, width, height, audioStreamCount)
+    }
+
+    @Suppress("unused")
+    private fun onNativeError(code: Int, message: String) {
+        if (nativeHandle == 0L) return
+        onError(code, message)
+    }
+
+    @Suppress("unused")
+    private fun onNativeComplete() {
+        if (nativeHandle == 0L) return
+        onComplete()
+    }
+
+    @Suppress("unused")
+    private fun onNativeProgress(positionMs: Long, durationMs: Long) {
+        if (nativeHandle == 0L) return
+        onProgress(positionMs, durationMs)
+    }
+
+    @Suppress("unused")
+    private fun onNativeFirstFrame() {
+        if (nativeHandle == 0L) return
+        onFirstFrame()
+    }
+
+    @Suppress("unused")
+    private fun onNativePcm(buffer: ByteBuffer, sampleRate: Int, channels: Int, ptsUs: Long): Boolean {
+        if (nativeHandle == 0L) return false
+        // channels is always 2 on output (see native replication);
+        // the parameter is kept for contract stability, not re-read.
+        ensureAudioTrack(sampleRate)
+        val track = audioTrack ?: return false
+        val written = runCatching { track.write(buffer, buffer.remaining(), AudioTrack.WRITE_BLOCKING) }.getOrDefault(-1)
+        return written >= 0
+    }
+
+    private external fun nativeStart(
+        path: String, surface: Surface, vocalStreamIndex: Int,
+        vocalMode: Int, leftGain: Float, rightGain: Float,
+    ): Long
+
+    private external fun nativeStop()
+    private external fun nativeSetPaused(paused: Boolean)
+    private external fun nativeSelectAudioStream(streamIndex: Int)
+    private external fun nativeSetVocalMode(mode: Int, leftGain: Float, rightGain: Float)
+    private external fun nativeSeekTo(positionMs: Long)
+}
