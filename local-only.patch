+    private fun deleteSmbSong(song: Song) {
+        if (currentSong?.equals(song) == true) {
+            toast("正在播放的歌曲不能删除")
+            return
+        }
+        val smbPath = song.smbPath
+        val smbServer = song.smbServer
+        if (smbPath.isNullOrBlank() || smbServer.isNullOrBlank()) {
+            toast("该歌曲没有共享盘路径，无法删除")
+            return
+        }
+        val config = smbBrowser.config()
+        if (!config.isConfigured()) {
+            toast("请先设置 SMB 共享盘")
+            smbBrowser.show()
+            return
+        }
+        if (config.normalizedServer() != smbServer) {
+            toast("当前 SMB 配置与该歌曲的服务器不一致，无法删除")
+            return
+        }
+        val snapshot = Song.fromJson(song.toJson())
+        try {
+            io.execute {
+                try {
+                    val client = SmbClient(config)
+                    // 访客登录按只读处理：不尝试删，直接提示（与设置页的
+                    // “访客登录一般只读”一致）；账号登录则用 testWrite 探针
+                    // 判断写权限，探针失败同样不尝试删。
+                    if (config.guest) {
+                        main.post { toast("当前共享盘账号没有写权限，无法删除") }
+                        return@execute
+                    }
+                    val writable = runCatching { client.testWrite() }.getOrDefault(false)
+                    if (!writable) {
+                        main.post { toast("当前共享盘账号没有写权限，无法删除") }
+                        return@execute
+                    }
+                    client.delete(smbPath)
+                    if (client.exists(smbPath)) throw java.io.IOException("共享盘文件删除后仍存在")
+                    library.removeSmb(snapshot)
+                    main.post {
+                        refreshLibrary {
+                            reloadCurrentBrowsePage()
+                        }
+                        toast("已从共享盘删除")
+                    }
+                } catch (error: Exception) {
+                    Log.w(TAG, "删除共享盘歌曲失败", error)
+                    main.post { toast("删除失败：" + (error.message?.take(120) ?: "请检查共享盘连接和写权限")) }
+                }
+            }
+        } catch (error: Exception) {
+            toast("删除失败：" + (error.message?.take(120) ?: "请检查共享盘连接和写权限"))
