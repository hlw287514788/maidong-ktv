+import android.graphics.Color
+import java.io.File
+import java.text.Normalizer
+import java.util.Locale
+
+/**
+ * 纯本地版歌手头像：本地照片优先 + 字母占位兜底，CDN 默认关。
+ *
+ * 本地照片目录：MaidongKTV/singer_avatars/（AppPaths.root 下），文件名就是歌手名，
+ * 后缀 .jpg/.png/.webp，名字做 NFKC 归一化、大小写不敏感匹配。启动时扫描一次建映射，
+ * 之后只查内存映射，不再反复列目录。
+ *
+ * 占位：没有本地照片时不空等、不联网，先显示歌手姓的第一个字 + 按歌手名哈希定的
+ * 固定颜色。颜色表是固定的 12 色，同一歌手在任何设备、任何次启动都是同一个颜色。
+ */
+object SingerAvatarLocal {
+    private val extensions = setOf("jpg", "jpeg", "png", "webp")
+    private val colors = intArrayOf(
+        0xFF4A90D9.toInt(), 0xFF50A8A0.toInt(), 0xFF7A6AD1.toInt(), 0xFFD97A4A.toInt(),
+        0xFF5CB85C.toInt(), 0xFFD9534F.toInt(), 0xFFE67E22.toInt(), 0xFF2E86AB.toInt(),
+        0xFF8E44AD.toInt(), 0xFF16A085.toInt(), 0xFFC0392B.toInt(), 0xFF34495E.toInt()
+    )
+
+    @Volatile private var scanned = false
+    private val byName = HashMap<String, File>()
+
+    /** 启动时调用一次；目录不存在或扫描失败时静默为空映射，不影响主流程。 */
+    @Synchronized fun scan() {
+        byName.clear()
+        runCatching {
+            val dir = File(AppPaths.root, "singer_avatars")
+            if (!dir.isDirectory) return
+            dir.listFiles().orEmpty().forEach { file ->
+                if (!file.isFile) return@forEach
+                val ext = file.name.substringAfterLast('.', "").lowercase(Locale.ROOT)
+                if (ext !in extensions) return@forEach
+                val name = file.name.substringBeforeLast('.')
+                if (name.isNotBlank()) byName.putIfAbsent(normalize(name), file)
+            }
+        }
+        scanned = true
+    }
+
+    /** 本地照片文件，没有返回 null；调用方拿到 null 时显示字母占位。 */
+    fun localFile(singer: String?): File? {
+        if (singer.isNullOrBlank()) return null
+        if (!scanned) scan()
+        return byName[normalize(singer)]
+    }
+
+    /** 占位用字：歌手姓的第一个字符（非空时），否则“歌”。 */
+    fun placeholderLetter(singer: String?): String {
+        val text = singer?.trim().orEmpty()
+        return if (text.isEmpty()) "歌" else text.substring(0, 1)
+    }
+
+    /** 占位颜色：按歌手名哈希固定取色，同一歌手永远同一颜色。 */
+    fun placeholderColor(singer: String?): Int {
+        val hash = singer?.hashCode() ?: 0
+        val index = ((hash % colors.size) + colors.size) % colors.size
+        return colors[index]
+    }
+
+    fun normalize(name: String): String =
+        Normalizer.normalize(name.trim(), Normalizer.Form.NFKC).lowercase(Locale.ROOT)
+
+    /** 占位颜色的十六进制文本（调试/日志用，不进 UI 文案）。 */
+    fun placeholderColorHex(singer: String?): String =
+        "#%06X".format(0xFFFFFF and placeholderColor(singer))
+}
