@@ -0,0 +1,40 @@
+package com.local.ktv
+
+import android.util.Log
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 纯本地版播放报错日志：与 SmbDiagLog / CrashRecorder 同一位置
+ * （AppPaths.root，即 /storage/emulated/0/MaidongKTV/），
+ * 文件名为 playback.log。
+ *
+ * 只在播放失败时写，另加每首歌一行解码器信息（DECODE，见 KtvVideoView）；
+ * 不给正常播放/暂停/切换/切歌记其他日志，避免刷屏。
+ * 只追加、不覆盖旧记录；文件超过 512KB 时删掉重写（仿 CrashRecorder）。
+ * 写入失败只记 logcat，绝不让日志失败影响播放。
+ * 内容只含歌名、歌手、来源、路径（共享内相对路径或本地文件名）、
+ * 错误码、重试/跳歌结果、错误类名和简短信息，
+ * 绝不含 SMB 账号密码、OpenList 令牌——调用方只把这些字段传进来，
+ * 密码/令牌字段从不经过本对象。
+ */
+object PlaybackDiagLog {
+    private const val TAG = "PlaybackDiagLog"
+    private const val FILE_NAME = "playback.log"
+    private const val MAX_BYTES = 512L * 1024L
+
+    @Synchronized
+    fun append(line: String) {
+        runCatching {
+            val file = File(AppPaths.root, FILE_NAME)
+            runCatching { file.parentFile?.mkdirs() }
+            if (file.exists() && file.length() > MAX_BYTES) {
+                runCatching { file.delete() }
+            }
+            val stamp = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
+            file.appendText("[$stamp] $line\n")
+        }.onFailure { Log.w(TAG, "Cannot write playback diag log", it) }
+    }
+}
