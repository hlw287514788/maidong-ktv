@@ -0,0 +1,31 @@
+package com.local.ktv
+
+import android.util.Log
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * v15 SMB 诊断日志：与 CrashRecorder 同一位置（AppPaths.root，即
+ * /storage/emulated/0/MaidongKTV/），文件名为 smb-scan.log。
+ *
+ * 只追加、不覆盖旧记录；写入失败只记 logcat，绝不让扫描或上存失败。
+ * 内容只含服务器、共享名、文件夹、条目名、条数、错误类名和简短信息，
+ * 绝不含 SMB 账号密码——调用方只把这些字段传进来，密码字段从不
+ * 经过本对象。
+ */
+object SmbDiagLog {
+    private const val TAG = "SmbDiagLog"
+    private const val FILE_NAME = "smb-scan.log"
+
+    @Synchronized
+    fun append(line: String) {
+        runCatching {
+            val file = File(AppPaths.root, FILE_NAME)
+            runCatching { file.parentFile?.mkdirs() }
+            val stamp = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
+            file.appendText("[$stamp] $line\n")
+        }.onFailure { Log.w(TAG, "Cannot write SMB diag log", it) }
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbHttpProxy.kt b/app/src/main/java/com/local/ktv/SmbHttpProxy.kt
new file mode 100644
index 0000000..5b3c798
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbHttpProxy.kt
@@ -0,0 +1,176 @@
+package com.local.ktv
+
+import java.io.BufferedOutputStream
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.Locale
+
+/**
+ * 本地 HTTP 代理：把 SMB 文件桥接成 MediaPlayer 能直接打开的地址。
+ *
+ * 原理：系统 MediaPlayer 对 http/https URL 直接打开，且拖动时会发
+ * Range 请求。代理只监听 127.0.0.1（本机回环，局域网
+ * 其他设备连不进来），每次 HTTP 连接新建一个 [SmbDataSource]，按
+ * Range 的起始位置 seek，再把字节流回去；拖动 = 新连接 + 新 Range，
+ * 不需要把整首歌先下完。
+ *
+ * 安全边界：
+ * - 只绑 127.0.0.1，不绑 0.0.0.0；只响应固定路径 "/smb"，其他路径 404。
+ * - 不做目录浏览、不接受写请求（只处理 GET，HEAD 返回头信息）。
+ * - 播放结束或切歌时调用方必须调用 [stop]，否则回环端口会一直占着。
+ * - 任何一次连接里的 SMB 异常都只关掉这条连接，不杀掉整个代理，
+ *   也不让异常穿到主线程。
+ */
+class SmbHttpProxy(
+    private val client: SmbClient,
+    private val path: String,
+    private val fileName: String,
+) {
+    @Volatile private var server: ServerSocket? = null
+    @Volatile private var acceptThread: Thread? = null
+    @Volatile private var running = false
+
+    /** 启动后返回给播放器的地址，例如 http://127.0.0.1:54321/smb 。 */
+    @Volatile var url: String? = null
+        private set
+
+    @Synchronized
+    fun start(): String {
+        if (running) return checkNotNull(url) { "代理已启动但地址缺失" }
+        val socket = ServerSocket(0, 8, java.net.InetAddress.getByName("127.0.0.1"))
+        server = socket
+        running = true
+        url = "http://127.0.0.1:${socket.localPort}/smb"
+        val thread = Thread({ acceptLoop(socket) }, "SmbHttpProxy-accept")
+        thread.isDaemon = true
+        acceptThread = thread
+        thread.start()
+        return checkNotNull(url)
+    }
+
+    @Synchronized
+    fun stop() {
+        running = false
+        runCatching { server?.close() }
+        server = null
+        url = null
+    }
+
+    private fun acceptLoop(socket: ServerSocket) {
+        while (running) {
+            val connection = try {
+                socket.accept()
+            } catch (ignored: Exception) {
+                // stop() 关掉 ServerSocket 时 accept 会抛异常，这是正常退出路径。
+                break
+            }
+            val worker = Thread({ handle(connection) }, "SmbHttpProxy-worker")
+            worker.isDaemon = true
+            worker.start()
+        }
+    }
+
+    private fun handle(connection: Socket) {
+        var source: SmbDataSource? = null
+        try {
+            connection.soTimeout = 15000
+            val reader = BufferedReader(InputStreamReader(connection.getInputStream(), Charsets.US_ASCII))
+            val requestLine = reader.readLine() ?: return
+            val parts = requestLine.split(' ')
+            if (parts.size < 2 || parts[0] != "GET" && parts[0] != "HEAD") {
+                writeStatus(connection, 405, "Method Not Allowed", 0L, null)
+                return
+            }
+            if (parts[1] != "/smb") {
+                writeStatus(connection, 404, "Not Found", 0L, null)
+                return
+            }
+            var rangeStart: Long? = null
+            var rangeEnd: Long? = null
+            while (true) {
+                val header = reader.readLine() ?: break
+                if (header.isEmpty()) break
+                if (header.lowercase(Locale.ROOT).startsWith("range:")) {
+                    // 只支持单段 Range：bytes=start- 或 bytes=start-end。
+                    val value = header.substringAfter(':').trim()
+                    if (value.startsWith("bytes=")) {
+                        val range = value.substring("bytes=".length).split('-')
+                        if (range.size == 2) {
+                            rangeStart = range[0].toLongOrNull()
+                            rangeEnd = range[1].toLongOrNull()
+                        }
+                    }
+                }
+            }
+            source = SmbDataSource(client, path)
+            val total = source.open()
+            val start = (rangeStart ?: 0L).coerceIn(0L, total)
+            val end = (rangeEnd ?: (total - 1)).coerceIn(start, total - 1)
+            val bodyLength = if (total == 0L) 0L else end - start + 1
+            val isRange = rangeStart != null
+            val status = if (isRange) 206 else 200
+            val statusText = if (isRange) "Partial Content" else "OK"
+            val extra = if (isRange) "Content-Range: bytes $start-$end/$total\r\n" else ""
+            writeStatus(
+                connection, status, statusText, bodyLength,
+                extra + "Accept-Ranges: bytes\r\n" +
+                    "Content-Type: " + contentTypeFor(fileName) + "\r\n",
+            )
+            if (parts[0] == "HEAD" || total == 0L) return
+            source.seek(start)
+            val output = BufferedOutputStream(connection.getOutputStream())
+            val buffer = ByteArray(128 * 1024)
+            var remaining = bodyLength
+            while (remaining > 0) {
+                val want = minOf(buffer.size.toLong(), remaining).toInt()
+                val n = source.read(buffer, 0, want)
+                if (n < 0) break
+                output.write(buffer, 0, n)
+                remaining -= n
+            }
+            output.flush()
+        } catch (ignored: Exception) {
+            // 客户端断开、SMB 断线、拖动取消都会走到这里：只关本条连接。
+        } finally {
+            runCatching { source?.close() }
+            runCatching { connection.close() }
+        }
+    }
+
+    private fun writeStatus(
+        connection: Socket,
+        code: Int,
+        text: String,
+        bodyLength: Long,
+        extraHeaders: String?,
+    ) {
+        val head = StringBuilder()
+        head.append("HTTP/1.1 ").append(code).append(' ').append(text).append("\r\n")
+        head.append("Content-Length: ").append(bodyLength).append("\r\n")
+        if (!extraHeaders.isNullOrEmpty()) head.append(extraHeaders)
+        head.append("Connection: close\r\n")
+        head.append("\r\n")
+        val output = BufferedOutputStream(connection.getOutputStream())
+        output.write(head.toString().toByteArray(Charsets.US_ASCII))
+        output.flush()
+    }
+
+    private fun contentTypeFor(name: String): String {
+        return when (name.substringAfterLast('.', "").lowercase(Locale.ROOT)) {
+            "mkv" -> "video/x-matroska"
+            "mp4", "m4v" -> "video/mp4"
+            "avi" -> "video/x-msvideo"
+            "mpg", "mpeg" -> "video/mpeg"
+            "ts", "m2ts" -> "video/mp2t"
+            "mov" -> "video/quicktime"
+            "webm" -> "video/webm"
+            "mp3" -> "audio/mpeg"
+            "flac" -> "audio/flac"
+            "wav" -> "audio/wav"
+            "m4a" -> "audio/mp4"
+            else -> "application/octet-stream"
+        }
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbjDiag.kt b/app/src/main/java/com/local/ktv/SmbjDiag.kt
new file mode 100644
index 0000000..c2882d5
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbjDiag.kt
@@ -0,0 +1,135 @@
+package com.local.ktv
+
+import com.hierynomus.smbj.SMBClient
+// 注意：不 import com.hierynomus.smbj.SmbConfig——本包已有同名
+// com.local.ktv.SmbConfig（配置类），同名 import 会产生歧义，
+// 下面的 SMBJ 配置用全限定名 com.hierynomus.smbj.SmbConfig。
+import com.hierynomus.smbj.auth.AuthenticationContext
+import com.hierynomus.smbj.connection.Connection
+import com.hierynomus.smbj.share.DiskShare
+import java.util.concurrent.TimeUnit
+
+/**
+ * v17 SMBJ 列目录诊断：只读。v18 起扫描主路径已改走 SMBJ
+ * （见 SmbjScanner），本对象只剩根目录/共享目录的诊断佐证；
+ * 纯本地版起播放读取、删除、连接/写权限测试也已全部改走
+ * SMBJ（见 SmbClient），jcifs 已从依赖里移除。
+ *
+ * 背景：jcifs 在 H2 上无论 SMB1 还是 SMB2/3、无论根目录还是 /ktv、
+ * 无论 listFiles 还是 list()，都返回 0 条且成功，而 Windows 客户端
+ * 能列出同一共享盘下的 8 首歌，服务器、模板、协议版本、账号设置
+ * 都已排除。换一个纯 Java SMB2/3 库（SMBJ）只列一次目录，看它
+ * 能不能列出同样的文件，就能分清是 jcifs 客户端的问题还是
+ * Android 这边其他环节的问题。
+ *
+ * 路径规则：DiskShare 已绑定到共享名，
+ * 所以路径是相对共享的，不带前导斜杠、不带共享名。根目录用
+ * 空字符串，配置根目录 /ktv 用 "ktv"。空字符串在个别版本上
+ * 若被拒绝，会再试一次 "/"，两次都失败才算该次尝试失败。
+ *
+ * 安全：本对象只接收 SmbConfig，从不把账号密码写进任何日志；
+ * 调用方（SongLibrary）只把条数、条目名、错误类名和简短信息
+ * 写进 smb-scan.log。连接、会话、共享用完都在 finally 里
+ * runCatching 关闭，关闭失败不影响扫描。
+ *
+ * API 23 注意：只用 Java 8 / Kotlin 标准库方法，不用
+ * 任何 Android 24+ 才有的 Map 默认方法、集合工厂方法和
+ * 流式 API，也不用新版时间 API；超时各 15 秒，避免诊断卡死扫描。
+ */
+object SmbjDiag {
+
+    data class Attempt(
+        val method: String,
+        val path: String,
+        val ok: Boolean,
+        val count: Int,
+        val names: List<String>,
+        val error: String?,
+    )
+
+    data class Diagnosis(
+        val rootAttempt: Attempt,
+        val configAttempt: Attempt,
+    )
+
+    fun diagnose(config: SmbConfig): Diagnosis {
+        val normalizedRoot = SmbConfig.normalizePath(config.root)
+        var client: SMBClient? = null
+        var connection: Connection? = null
+        var share: DiskShare? = null
+        try {
+            config.validate()
+            val smbConfig = com.hierynomus.smbj.SmbConfig.builder()
+                .withTimeout(15, TimeUnit.SECONDS)
+                .withSoTimeout(15, TimeUnit.SECONDS)
+                .build()
+            client = SMBClient(smbConfig)
+            connection = client.connect(config.normalizedServer(), config.port)
+            val auth = if (config.guest) {
+                AuthenticationContext.anonymous()
+            } else {
+                AuthenticationContext(config.username.trim(), config.password.toCharArray(), null)
+            }
+            val session = connection.authenticate(auth)
+            val connected = session.connectShare(config.share.trim())
+            if (connected !is DiskShare) {
+                throw IllegalStateException("共享不是磁盘共享")
+            }
+            share = connected
+            val root = attempt(share, "SMBJ-list-根目录", "/")
+            val cfg = attempt(share, "SMBJ-list-共享目录", normalizedRoot)
+            return Diagnosis(root, cfg)
+        } catch (error: Throwable) {
+            val message = error.javaClass.simpleName + ": " + (error.message ?: "")
+            return Diagnosis(
+                Attempt("SMBJ-list-根目录", "/", false, -1, emptyList(), message),
+                Attempt("SMBJ-list-共享目录", normalizedRoot, false, -1, emptyList(), message),
+            )
+        } finally {
+            runCatching { share?.close() }
+            runCatching { connection?.close() }
+            runCatching { client?.close() }
+        }
+    }
+
+    private fun attempt(share: DiskShare, method: String, logicalPath: String): Attempt {
+        return runCatching {
+            val names = listNames(share, logicalPath)
+            Attempt(method, logicalPath, true, names.size, names.take(20), null)
+        }.getOrElse { error ->
+            Attempt(
+                method, logicalPath, false, -1, emptyList(),
+                error.javaClass.simpleName + ": " + (error.message ?: ""),
+            )
+        }
+    }
+
+    private fun listNames(share: DiskShare, logicalPath: String): List<String> {
+        val relative = if (logicalPath == "/") "" else logicalPath.trimStart('/')
+        val candidates = ArrayList<String>()
+        candidates.add(relative)
+        if (relative.isEmpty()) {
+            candidates.add("/")
+        } else {
+            candidates.add("/" + relative)
+        }
+        var lastError: Throwable? = null
+        for (candidate in candidates) {
+            try {
+                val raw = share.list(candidate)
+                val names = ArrayList<String>()
+                for (entry in raw) {
+                    val name = entry.fileName
+                    if (name.isEmpty() || name == "." || name == "..") continue
+                    val entryPath = if (relative.isEmpty()) name else relative + "/" + name
+                    val isDir = runCatching { share.folderExists(entryPath) }.getOrDefault(false)
+                    names.add(if (isDir) name + "/" else name)
+                }
+                return names
+            } catch (error: Throwable) {
+                lastError = error
+            }
+        }
+        throw lastError ?: java.io.IOException("SMBJ 列目录失败")
+    }
+}
diff --git a/app/src/main/java/com/local/ktv/SmbjScanner.kt b/app/src/main/java/com/local/ktv/SmbjScanner.kt
new file mode 100644
index 0000000..aee4a22
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/SmbjScanner.kt
@@ -0,0 +1,146 @@
+package com.local.ktv
+
+import com.hierynomus.smbj.SMBClient
+import com.hierynomus.smbj.auth.AuthenticationContext
+import com.hierynomus.smbj.connection.Connection
+import com.hierynomus.smbj.share.DiskShare
+import java.util.concurrent.TimeUnit
+
+/**
+ * v18：SMB 扫描用的目录枚举，改走 SMBJ。
+ *
+ * 背景（v17 #37 真机诊断，smb-scan-3.log，三次扫描一致）：
+ * 同一服务器/账号/文件夹，jcifs 无论 SMB2/3 还是 SMB1、根目录
+ * 还是 /ktv 都返回 0 条，而 SMBJ 列出根目录 27 条（含 ktv/）、
+ * /ktv 8 首 .mkv，与 Windows 一致。jcifs 的列目录本身是坏的。
+ * 纯本地版已把 jcifs 全部换掉：扫描从这里列，文件读（播放代理）、
+ * 删除、写权限测试都走 SmbClient（SMBJ），上存/下载已随纯本地版拿掉。
+ *
+ * 返回值与原来 SmbClient.listFilesRecursive 的语义完全一致，
+ * SongLibrary.syncSmb 不用改过滤、查库、去重、落盘逻辑：
+ * - 只返回文件，不返回目录本身；目录只用于递归；
+ * - 递归深度默认 8，visited 按共享内绝对路径防回环；
+ * - 任何一层列目录失败都直接抛给调用方，由 syncSmb 走失败路径
+ *   （记同步失败、保留上次索引），绝不静默返回空列表冒充 0 首；
+ * - Entry.path 是以 "/" 开头的共享内绝对路径（例如
+ *   "/ktv/210005213.mkv"），与原来、smbId、smbPath、
+ *   播放代理的路径语义完全一致。
+ *
+ * SMBJ 路径规则：DiskShare 已绑定到共享名，
+ * 所以这里的路径是相对共享的，不带前导斜杠、不带共享名。
+ * 配置根目录 /ktv 对应相对路径 "ktv"，共享根目录 "/" 对应 ""。
+ * 空字符串在个别情况下被拒绝时再试一次 "/"，非空相对路径
+ * 被拒绝时再试一次带前导斜杠的版本——这套兜底与 v17 的
+ * SmbjDiag.listNames 完全一致，是真机上已验证过的写法。
+ *
+ * 目录判断：用 share.folderExists(相对路径)，与 SmbjDiag 相同。
+ * 拿不到目录判断时按文件处理（getOrDefault(false)），目录名
+ * 本来也不会通过媒体扩展名过滤，所以不会把目录误当成歌。
+ * size / lastModified 填 0：扫描下游（Song.local、按编号查曲库）
+ * 只用 name 和 path，不用这两个字段；不在这里凭空编造 SMBJ
+ * 未经真机验证的字段读取方法。
+ *
+ * 安全：只接收 SmbConfig，从不把账号密码写进任何日志；
+ * 连接、会话、共享用完都在 finally 里 runCatching 关闭。
+ *
+ * API 23 注意：只用 Java 8 / Kotlin 标准库方法，不用
+ * 任何 Android 24+ 才有的 Map 默认方法、集合工厂方法和
+ * 流式 API；超时各 15 秒，与 SmbjDiag 一致。
+ */
+object SmbjScanner {
+
+    fun listFilesRecursive(config: SmbConfig, root: String, maxDepth: Int = 8): List<SmbClient.Entry> {
+        config.validate()
+        val normalizedRoot = SmbConfig.normalizePath(root)
+        var client: SMBClient? = null
+        var connection: Connection? = null
+        var share: DiskShare? = null
+        try {
+            val smbConfig = com.hierynomus.smbj.SmbConfig.builder()
+                .withTimeout(15, TimeUnit.SECONDS)
+                .withSoTimeout(15, TimeUnit.SECONDS)
+                .build()
+            client = SMBClient(smbConfig)
+            connection = client.connect(config.normalizedServer(), config.port)
+            val auth = if (config.guest) {
+                AuthenticationContext.anonymous()
+            } else {
+                AuthenticationContext(config.username.trim(), config.password.toCharArray(), null)
+            }
+            val session = connection.authenticate(auth)
+            val connected = session.connectShare(config.share.trim())
+            if (connected !is DiskShare) {
+                throw IllegalStateException("共享不是磁盘共享")
+            }
+            share = connected
+            val result = ArrayList<SmbClient.Entry>()
+            val visited = HashSet<String>()
+            val rootRelative = if (normalizedRoot == "/") "" else normalizedRoot.trimStart('/')
+            walk(share, normalizedRoot, rootRelative, 0, maxDepth, visited, result)
+            return result
+        } finally {
+            runCatching { share?.close() }
+            runCatching { connection?.close() }
+            runCatching { client?.close() }
+        }
+    }
+
+    private fun walk(
+        share: DiskShare,
+        absolute: String,
+        relative: String,
+        depth: Int,
+        maxDepth: Int,
+        visited: HashSet<String>,
+        result: ArrayList<SmbClient.Entry>,
+    ) {
+        if (depth > maxDepth) return
+        if (!visited.add(SmbConfig.normalizePath(absolute))) return
+        val names = listDir(share, relative)
+        for (name in names) {
+            if (name.isEmpty() || name == "." || name == "..") continue
+            val childRelative = if (relative.isEmpty()) name else relative + "/" + name
+            val childAbsolute = "/" + childRelative
+            val isDir = runCatching { share.folderExists(childRelative) }.getOrDefault(false)
+            if (isDir) {
+                walk(share, childAbsolute, childRelative, depth + 1, maxDepth, visited, result)
+            } else {
+                result.add(
+                    SmbClient.Entry(
+                        name = name,
+                        path = childAbsolute,
+                        isDirectory = false,
+                        size = 0L,
+                        lastModified = 0L,
+                    ),
+                )
+            }
+        }
+    }
+
+    // 只返回条目名，不暴露 SMBJ 列表项类型：share.list() 的返回项
+    // 在这里用 fileName 取名（与 SmbjDiag 完全相同的写法），
+    // 调用方 walk 只需要名字，目录判断另走 folderExists。
+    private fun listDir(share: DiskShare, relative: String): List<String> {
+        val candidates = ArrayList<String>()
+        candidates.add(relative)
+        if (relative.isEmpty()) {
+            candidates.add("/")
+        } else {
+            candidates.add("/" + relative)
+        }
+        var lastError: Throwable? = null
+        for (candidate in candidates) {
+            try {
+                val names = ArrayList<String>()
+                for (entry in share.list(candidate)) {
+                    names.add(entry.fileName)
+                }
+                return names
+            } catch (error: Throwable) {
+                lastError = error
+            }
+        }
+        throw lastError ?: java.io.IOException("SMBJ 列目录失败")
+    }
+}
