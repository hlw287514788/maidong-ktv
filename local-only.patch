 package com.local.ktv
 
 import org.json.JSONArray
+import org.json.JSONObject
 import java.io.File
 import java.util.Locale
 
+/**
+ * 纯本地版曲库：只剩三路来源——本地（含 U盘，scanLocal 里 includeUsb 已把 U盘并进
