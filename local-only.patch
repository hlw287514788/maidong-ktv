@@ -0,0 +1,23 @@
+package com.local.ktv
+
+import org.json.JSONObject
+import java.text.Normalizer
+import java.util.Locale
+
+/**
+ * 纯本地版拼音工具：只依赖 assets 里的 pinyin_chars.json，不依赖任何曲库数据库。
+ * 原先这两个函数住在 IgebaCatalogBootstrapper 里，纯本地版把曲库删掉后搬到这里，
+ * 搜索、歌星聚合、文件名解析的拼音字段继续用它。
+ */
+object PinyinUtils {
+    private val chars by lazy { JSONObject(CatalogAssets.pinyinChars()) }
+
+    fun fullPinyin(name: String): String =
+        name.map { chars.optString(it.toString(), it.toString()) }.joinToString("").uppercase(Locale.ROOT)
+
+    fun initials(name: String): String =
+        name.map { chars.optString(it.toString(), it.toString()).take(1) }.joinToString("").uppercase(Locale.ROOT)
+
+    fun normalizeName(name: String): String =
+        Normalizer.normalize(name.trim(), Normalizer.Form.NFKC).lowercase(Locale.ROOT)
+}
