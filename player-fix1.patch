@@ -182,9 +182,14 @@ class FfmpegHwSession(
     // ---- Called from native code. Names/signatures must match the
     // ---- GetMethodID lookups in ffmpeg_hw_player.cpp exactly. ----
 
+    // fix1: do NOT drop onNativePrepared on nativeHandle == 0. nativeStart
+    // calls prepared synchronously before returning, while Kotlin sets
+    // nativeHandle only after nativeStart returns, so the guard would
+    // discard the success callback forever. The caller's generation
+    // check is the second line of defence, and stop() joins the native
+    // threads, so no stale session's prepared can arrive after stop.
     @Suppress("unused")
     private fun onNativePrepared(durationMs: Long, width: Int, height: Int, audioStreamCount: Int) {
-        if (nativeHandle == 0L) return
         onPrepared(durationMs, width, height, audioStreamCount)
     }
 
