diff --git a/app/src/main/java/com/local/ktv/CrashRecorder.kt b/app/src/main/java/com/local/ktv/CrashRecorder.kt
new file mode 100644
index 0000000..4c1232d
--- /dev/null
+++ b/app/src/main/java/com/local/ktv/CrashRecorder.kt
@@ -0,0 +1,77 @@
+package com.local.ktv
+
+import android.util.Log
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * H2 / Android 6.0 diagnostics.
+ *
+ * Java/Kotlin crashes used to leave no trace on the projector, so a
+ * "tap to order -> app disappears" report could not be tied to a stack trace.
+ * This recorder writes every uncaught exception, plus every exception caught
+ * on the song-order path, to MaidongKTV/crash.log on external storage.
+ *
+ * It never throws: if the log file cannot be written (no permission, storage
+ * not mounted), the failure is only logged to logcat and the app continues.
+ * For uncaught exceptions the previous default handler is still invoked, so
+ * the system crash behaviour is unchanged -- this only adds a log first.
+ *
+ * Limitation, stated honestly: this captures Java/Kotlin exceptions only.
+ * A native signal crash (e.g. inside a native decoder .so) does not go
+ * through the Java uncaught handler and will not appear here.
+ */
+object CrashRecorder {
+    private const val TAG = "CrashRecorder"
+    private const val FILE_NAME = "crash.log"
+    private const val MAX_BYTES = 512L * 1024L
+
+    @Volatile
+    private var installed = false
+
+    fun install() {
+        if (installed) return
+        installed = true
+        val previous = Thread.getDefaultUncaughtExceptionHandler()
+        Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
+            runCatching { append("UNCAUGHT thread=${thread.name}", throwable) }
+            if (previous != null) {
+                previous.uncaughtException(thread, throwable)
+            } else {
+                // No previous handler: keep the old behaviour of killing the
+                // process, now that the trace has been written.
+                android.os.Process.killProcess(android.os.Process.myPid())
+            }
+        }
+    }
+
+    /** Record an exception that was caught and turned into a toast. */
+    fun record(tag: String, throwable: Throwable) {
+        runCatching { append("CAUGHT $tag", throwable) }
+            .onFailure { Log.w(TAG, "Cannot write crash log", it) }
+    }
+
+    @Synchronized
+    private fun append(kind: String, throwable: Throwable) {
+        val file = File(AppPaths.root, FILE_NAME)
+        runCatching { file.parentFile?.mkdirs() }
+        if (file.exists() && file.length() > MAX_BYTES) {
+            runCatching { file.delete() }
+        }
+        val stamp = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
+        val writer = StringBuilder()
+        writer.append("=== $stamp $kind ===\n")
+        writer.append(throwable.toString()).append('\n')
+        throwable.stackTrace.take(60).forEach { writer.append("    at ").append(it).append('\n') }
+        var cause = throwable.cause
+        while (cause != null) {
+            writer.append("Caused by: ").append(cause.toString()).append('\n')
+            cause.stackTrace.take(20).forEach { writer.append("    at ").append(it).append('\n') }
+            cause = cause.cause
+        }
+        writer.append('\n')
+        file.appendText(writer.toString())
+    }
+}
